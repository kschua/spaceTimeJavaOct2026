,f.godToStem.do],W.aspects=['resource','companion'],W.elements=[f.aspectToElement.resource,f.aspectToElement.companion],W.gods=['ir','dr','f','rw'],W.stems=[f.godToStem.ir,f.godToStem.dr,f.godToStem.f,f.godToStem.rw]):(M.aspects=['resource','companion'],M.elements=[f.aspectToElement.resource,f.aspectToElement.companion],M.gods=['ir','dr','f','rw'],M.stems=[f.godToStem.ir,f.godToStem.dr,f.godToStem.f,f.godToStem.rw],W.aspects=['output','wealth','power'],W.elements=[f.aspectToElement.output,f.aspectToElement.wealth,f.aspectToElement.power],W.gods=['eg','ho','iw','dw','7k','do'],W.stems=[f.godToStem.eg,f.godToStem.ho,f.godToStem.iw,f.godToStem.dw,f.godToStem['7k'],f.godToStem.do]),t.meta.favorable=M,t.meta.unfavorable=W}},1342,[4,1,33,6,934,955,1339,1341,409]);
__d(function(e,i,n,t,a,o,s){var r=i(s[0]),l=i(s[1]);Object.defineProperty(o,"__esModule",{value:!0}),o.usefulGodSymbols=o.hours=o.formStructureForLibrary=o.structures=o.formations=o.victories=o.displayTerminology=o.spirits=o.stars=o.doors=void 0;l(i(s[2])),l(i(s[3])),l(i(s[4]));var h=r(i(s[5]));o.doors={rest:{$dict_noun:['serenity','clarity','recovery'],specialInteraction:{kan:"fu yin",xun:"grave",li:"fan yin"},palaceInteraction:{kan:"harmony",gen:"countered",zhen:"produce",xun:"produce",li:"compelled",kun:"countered",dui:"produced",qian:"produced"},strength:{0:7,1:7,2:7,3:6,4:6,5:6,6:5,7:5,8:5,9:4,10:4,11:4,12:5,13:5,14:5,15:6,16:6,17:6,18:7,19:7,20:7,21:8,22:8,23:8},details:{natalPalace:"kan",element:"water",originalDirection:"N",luoShuNumber:"1",branches:"\u5b50 Zi (Rat)",auspiciousness:"Very Auspicious",symbols:"rejuvenation, recovery, persistence, stability, social comfort, sleep, massages",people:"helpful people, mentors, officials, older people, noblemen, leaders",places:"rivers, seas, cafes, vacation homes, nursing homes",things:"bed, clouds, mist, wine, soup, kidney, ear, milk",suitable:'recovery, learning, negotiation, seeking help, recruiting, social activities'},$body:'The Rest Door is the gateway to serenity \u2014 a place where the breeze carries the scent of the blue sea.  It can be visualized as a joyous puppy rolling around in the soft, white sand.\n\nWhen one enters the Rest Door, tension tends to fade and is replaced by a sense of clarity.  One will be able to look at problems from a big-picture perspective, enabling the discovery of creative solutions that was never once considered.  Relationships with others will mend and bond as self-centeredness gives way to a great whole.  Those born with the Rest Door have the wisdom and empathy to understand that the moments in life are to be delicately savored.'},life:{$dict_noun:['growth','splendor','prosperity'],specialInteraction:{gen:"fu yin",xun:"grave",kun:"fan yin"},palaceInteraction:{kan:"compelled",gen:"harmony",zhen:"countered",xun:"countered",li:"produced",kun:"harmony",dui:"produce",qian:"produce"},strength:{0:8,1:8,2:8,3:7,4:7,5:7,6:6,7:6,8:6,9:5,10:5,11:5,12:4,13:4,14:4,15:5,16:5,17:5,18:6,19:6,20:6,21:7,22:7,23:7},details:{natalPalace:"gen",element:"earth",originalDirection:"NE",luoShuNumber:"8",branches:"\u4e11 Chou (Ox), \u5bc5 Yin (Tiger)",auspiciousness:"Very Auspicious",symbols:"generating wealth, survival, growth, movement, prosperity, livelihood, abundance, freshness, birth",people:"officers, businessmen, ambitious leaders, farmers, baby",places:"banks, farmlands, mountains, grass, plantations, sunshine",things:"money, nutrition, technology, awards",suitable:'wealth, commerce, fame, marriage, travel, construction, health, recovery, childbirth, spiritual'},$body:'The Life Door is the gateway to growth \u2014 a catalyst to progress any situation or event.  It is visualized as a sprawling metropolis with obsessed individuals working every waking hour to build a civilization of maximal production.  The Life Door is considered the most desired of all doors because it can be applied to amass extraordinary amounts of wealth or power.\n\nWhen one enters the Life Door, an immediate boost is applied to the situation in focus.  Those born with this door in their palace often notice an unmistakable desire for advancement and progression.  Those with this door find themselves able to recover from illness or harm quicker than others.  The Life Door is a symbol of monumental potential.  It would be wise to carefully plan the trajectory before applying the Life Door to the situation.  Otherwise, the situation may advance to a state where one may not have intended.'},harm:{$dict_noun:['victory','damage','instability'],specialInteraction:{zhen:"fu yin",kun:"grave",dui:"fan yin"},palaceInteraction:{kan:"produced",gen:"compelled",zhen:"harmony",xun:"harmony",li:"produce",kun:"compelled",dui:"countered",qian:"countered"},strength:{0:7,1:7,2:7,3:8,4:8,5:8,6:7,7:7,8:7,9:6,10:6,11:6,12:5,13:5,14:5,15:4,16:4,17:4,18:5,19:5,20:5,21:6,22:6,23:6},details:{natalPalace:"zhen",element:"wood",originalDirection:"E",luoShuNumber:"3",branches:"\u536f Mao (Rabbit)",auspiciousness:"Neutral",symbols:"formidability, destruction, damage, force, speed",people:"police, enemies, rivals, soldiers",places:"secure areas, underground, hospitals, war zones, jungles",things:"thunder, cars, speedboats, liver, livestock, debt",suitable:'aggressive pursuit of matters, hunting, lawsuits, winning in a competition'},$body:'The Harm Door is a gateway to victory.  It can be visualized as a gladiator sacrificing his safety to defeat the enemy at all costs.  He who remains standing is the champion.\n\nWhen utilized properly, this door can bring tremendous force to stop an opponent from achieving their goal.  It is considered a door of last resort, as it is known for its devastating and immediate effects.  When one enters the door, he shall find that while victory can be quickly secured, it is without the absence of collateral damage.  Those born with the Harm Door are thrill seekers who welcome risk and volatility.  They do not look at life as a smooth sailing river but rather a dangerous jungle to be explored and paved.'},delusion:{$dict_noun:['mystery','uncertainty','shadow'],specialInteraction:{xun:"fu yin",kun:"grave",qian:"fan yin"},palaceInteraction:{kan:"produced",gen:"compelled",zhen:"harmony",xun:"harmony",li:"produce",kun:"compelled",dui:"countered",qian:"countered"},strength:{0:6,1:6,2:6,3:7,4:7,5:7,6:8,7:8,8:8,9:7,10:7,11:7,12:6,13:6,14:6,15:5,16:5,17:5,18:4,19:4,20:4,21:5,22:5,23:5},details:{natalPalace:"xun",element:"wood",originalDirection:"SE",luoShuNumber:"4",branches:"\u8fb0 Chen (Dragon), \u5df3 Si (Snake)",auspiciousness:"Neutral",symbols:"knowledge, secrecy, patience, planning, stability, concealment, stubbornness",people:"military officers, academics, researchers, artists, guards, thieves, monks, hermits",places:"schools, caves, libraries, hotels, cabins, cellars, hideouts",things:"information, dark items, soft things, liver, seafood, blockages",suitable:'planning, waiting, hiding, secrets, hindering enemies, evading'},$body:'The Delusion Door is the gateway to concealment -- a dark cave where one can be kept safe from the dangers of the world.  It is the invisibility cloak that allows the mage to avoid attention.\n\nWhen one enters the Delusion Door, he is hidden from plain sight.  Spoken words cannot be heard.  The visible becomes a blur.  Enemies are ignorant of your intentions as their sources of information is now contaminated.  It is a door for secrecy, planning, and learning new subjects.  Those who are born with the Delusion Door will find that stepping back from chaotic situations and retreating to safety will come at ease.'},scenery:{$dict_noun:['perception','impression','attraction'],specialInteraction:{kan:"fan yin",li:"fu yin",qian:"grave"},palaceInteraction:{kan:"countered",gen:"produce",zhen:"produced",xun:"produced",li:"harmony",kun:"produce",dui:"compelled",qian:"compelled"},strength:{0:5,1:5,2:5,3:6,4:6,5:6,6:7,7:7,8:7,9:8,10:8,11:8,12:7,13:7,14:7,15:6,16:6,17:6,18:5,19:5,20:5,21:4,22:4,23:4},details:{natalPalace:"li",element:"fire",originalDirection:"S",luoShuNumber:"9",branches:"Wu \u5348 (Horse)",auspiciousness:"Mild Auspicious",symbols:"beauty, presentation, expression, communication, britheness, views",people:"younger generation, show-offs, high status, salesmen, marketers",places:"stage, malls, ballrooms, galleries, movie theaters, bars",things:"fashion, purple, books, art, news, desserts, sun, warmth, documents, contracts",suitable:'presentations, speeches, job interviews, exams, meeting new people, gaining charisma'},$body:'The Scenery Door is the gateway to perception \u2014 a splendid costume giving the wearer an unmistakable aura of charisma.  It can be visualized as a beautiful model strolling down the the runway with perfect form.\n\nThis door is a picture of fame and success.   When one enters the Scenery Door, their voice can be assured that it will travel far and wide.  Statements become definitive and persuasive; ideas become charming and creative.  This door is best used for purposes of sales and marketing, as the audience will surely find the magnetic attraction a sight to behold.  Those born with the Scenery Door have a controlling presence in social situations.  They project a feeling of optimistic enthusiasm that can easily take the world by storm.'},death:{$dict_noun:['stagnation','convergence','conclusion'],specialInteraction:{gen:"fan yin",xun:"grave",kun:"fu yin"},palaceInteraction:{kan:"compelled",gen:"harmony",zhen:"countered",xun:"countered",li:"produced",kun:"harmony",dui:"produce",qian:"produce"},strength:{0:4,1:4,2:4,3:5,4:5,5:5,6:6,7:6,8:6,9:7,10:7,11:7,12:8,13:8,14:8,15:7,16:7,17:7,18:6,19:6,20:6,21:5,22:5,23:5},details:{natalPalace:"kun",element:"earth",originalDirection:"SW",luoShuNumber:"2",branches:"\u672a Wei (Goat), \u7533 Shen (Monkey)",auspiciousness:"Inauspicious",symbols:"stagnation, stoppage, hindrance, danger, unhappiness, decline",people:"patients, prisoners, unhappy people, unsuccessful leaders",places:"graveyards, open areas, dangerous places",things:"pollution, spleen, black items, poison, coldness",suitable:'burials, funerals, ancestral worship'},$body:'The Death Door is the gateway to renewal.  It is the end of the road but also the beginning of a new adventure.  It can be visualized as a seed waiting to sprout into the essence of nature.\n\nWhen one enters the Death Door, he will be able to understand the circle of life.  Dualities of black and white, strong and weak, hard and soft become one and the same.  One will cease to become selfish, as they will see themselves as part of a greater whole.  The Death Door is the giver of emotions.  Those who are born with it have the ability to experience intense connectedness to the people and things around them.  The Death Door can bring an individual to the final stage of spiritual enlightenment.'},fear:{$dict_noun:['shock','solemnity','tension'],specialInteraction:{gen:"grave",zhen:"fan yin",dui:"fu yin"},palaceInteraction:{kan:"produce",gen:"produced",zhen:"compelled",xun:"compelled",li:"countered",kun:"produced",dui:"harmony",qian:"harmony"},strength:{0:5,1:5,2:5,3:4,4:4,5:4,6:5,7:5,8:5,9:6,10:6,11:6,12:7,13:7,14:7,15:8,16:8,17:8,18:7,19:7,20:7,21:6,22:6,23:6},details:{natalPalace:"dui",element:"metal",originalDirection:"W",luoShuNumber:"7",branches:"\u9149 You (Rooster)",auspiciousness:"Mild Inauspicious",symbols:"shock, fright, problems, betrayal, intimidation, paranoia, worry",people:"warriors, lawyers, fighters, singers, communicators",places:"camps, forts, enclosed areas",things:"lungs, mouth, easy to break things, red things",suitable:'scaring others, deceiving others, filing lawsuits, giving warnings'},$body:'The Fear Door is the gateway to uncertainty.  Even the strongest of willpower can fall to the slightest touch of doubt.  The Fear Door can be visualized as an owl who gazes into the eyes of a beast, offering the savage a minute image of itself.\n\nWhen one enters the Fear Door, he sends to his enemies a charge of intimidation that even the most confident cannot dismiss.  He sends his subordinates an empowering message.  This door acts by non-action.  The strong may doubt their strength.  The weak may notice their power.  Those born with the Fear Door possess an ability to influence those around them by offering a hypnotic mirror for reflection.'},open:{$dict_noun:['beginnings','creation','opportunity'],specialInteraction:{gen:"grave",xun:"fan yin",qian:"fu yin"},palaceInteraction:{kan:"produce",gen:"produced",zhen:"compelled",xun:"compelled",li:"countered",kun:"produced",dui:"harmony",qian:"harmony"},strength:{0:6,1:6,2:6,3:5,4:5,5:5,6:4,7:4,8:4,9:5,10:5,11:5,12:6,13:6,14:6,15:7,16:7,17:7,18:8,19:8,20:8,21:7,22:7,23:7},details:{natalPalace:"qian",element:"metal",originalDirection:"NW",luoShuNumber:"6",branches:"\u620c Xu (Dog), \u4ea5 Hai (Pig)",auspiciousness:"Very Auspicious",events:"new beginnings, promotion, advancement, moving forward",people:"open, generous, compassionate, new ideas, fatherly figures",places:"storefront, open fields, vast lands, factories, cities, horizon, heavens",things:"airplanes, food, productions, intestines, lung, esophagus, medicine, surgery, official matters",suitable:'new business, ceremonies, travelling, moving homes, construction, meeting people'},$body:'The Open Door is the gateway to new beginnings \u2014 the mark of opportunity and hope in human progress.  It can visualized as a young, energetic startup aiming to tackle the existing market.\n\nWhen one enters the Open Door, events tend to unfold in positive ways and obstacles seem to disappear.  Others will exhibit a receptive nature to novel proposals.  As the first of the eight doors, the Open Door is associated with proactive change.  Those with the Open Door in their palace will find that taking the role of a visionary or innovator will be most beneficial as opposed to following a preexisting flow of doing things. Those around them are already predestined to follow their steps.'}};o.stars={grass:{$dict_noun:['passivity','loss','malice'],specialInteraction:{kan:"fu yin",xun:"grave",li:"fan yin"},palaceInteraction:{kan:"harmony",gen:"countered",zhen:"produce",xun:"produce",li:"compelled",kun:"countered",dui:"produced",qian:"produced"},strength:{kan:'strong',gen:'trap',zhen:'peak',xun:'peak',li:'weak',kun:'weak',dui:'dead',qian:'dead'},details:{natalPalace:"kan",element:"water",originalDirection:"N",luoShuNumber:"1",branches:"\u5b50 Zi (Rat)",auspiciousness:"Very Inauspicious",symbols:"loss, risk, danger, corruption, sneakiness, robbery, boldness",people:"thieves, attacker, mafia, deep thinkers, schemers",places:"swamps, ocean, rivers, underground, dark places",things:"drugs, clouds, water, rain, kidney, bladder",suitable:'planning, remaining undetected, building defenses, enhancing protection, keeping status quo'},$body:'The Heavenly Grass governs wisdom.  When man discovered writing, the gods shook with fear.   This star dictates the extent of creative expression possible to shift cultures.  This star is correlated with persistence and stubbornness, and history reveals that this can often overextend to greed if not properly controlled.   Those born with the Grass are instilled with a desire to turn their imaginations into fruition.  Their ambition may lead them to over-indulge in rewards earned from their efforts. '},grain:{$dict_noun:['decay','conservation','virtue'],specialInteraction:{gen:"fan yin",xun:"grave",kun:"fu yin"},palaceInteraction:{kan:"compelled",gen:"harmony",zhen:"countered",xun:"countered",li:"produced",kun:"harmony",dui:"produce",qian:"produce"},strength:{kan:'weak',gen:'strong',zhen:'trap',xun:'trap',li:'dead',kun:'strong',dui:'peak',qian:'peak'},details:{natalPalace:"kun",element:"earth",originalDirection:"SW",luoShuNumber:"2",branches:"\u672a Wei (Goat), \u7533 Shen (Monkey)",auspiciousness:"Very Inauspicious",symbols:"illness, health, problems, weakness",people:"caretakers, mothers, students, farmers",places:"farms, plantations, hospitals",things:"sugar, clothing, parasites",suitable:'learning, strategizing, maintaining defenses, discussions, waiting, being passive'},$body:'The Heavenly Grain is governs stability.  It is the stone that cannot be broken.  As the biggest and most radiant of the Nine Stars, the Grain acts as a conservative anchor for the dualistic aspects of nature.   It enables the individual to be in-tune with their personal moral compass, giving a sense of what is right or wrong.  Those born with the Grain are often grounded in life, preferring to take matters one step at a time.  They are prone to risk aversion, as they prefer to grasp the security of the future rather than be surprised by it.  They maintain a small circle of trusted friends and place extreme loyalty to the chosen ones.'},destructor:{$dict_noun:['momentum','exertion','activity'],specialInteraction:{zhen:"fu yin",kun:"grave",dui:"fan yin"},palaceInteraction:{kan:"produced",gen:"compelled",zhen:"harmony",xun:"harmony",li:"produce",kun:"compelled",dui:"countered",qian:"countered"},strength:{kan:'dead',gen:'weak',zhen:'strong',xun:'strong',li:'peak',kun:'weak',dui:'trap',qian:'trap'},details:{natalPalace:"zhen",element:"wood",originalDirection:"E",luoShuNumber:"3",branches:"\u536f Mao (Rabbit)",auspiciousness:"Mild Auspicious",symbols:"warfare, speed, aggression, energy, force, strength",people:"fighters, competitors, athletes, leaders",places:"battlefield, jungle, arenas",things:"lightning, electricity, cables, bombs, weapons, tools",suitable:'taking first action, winning in competition, attacking instead of defending'},$body:'The Heavenly Destructor governs momentum.  It is a catalyst to all events on earth, emitting an energy signature of aggression, excitement, and passion.  Those who utilize this star may find that rationality becomes a secondary factor in the face of impulsive, intuitive, and instinctual action.  The warriors of the distant past move through the air without thought \u2014 their body follows a natural pattern that bypasses all calculations and logic. Those born with the Destructor Star are fierce in their approaches to life.  Adrenaline pumps throughout their body as they navigate their way through stressful and high-pressure situations.  Due to their daring nature, they are able to achieve their goals with unprecedented speed.'},assistant:{$dict_noun:['intelligence','culture','inspiration'],specialInteraction:{xun:"fu yin",kun:"grave",qian:"fan yin"},palaceInteraction:{kan:"produced",gen:"compelled",zhen:"harmony",xun:"harmony",li:"produce",kun:"compelled",dui:"countered",qian:"countered"},strength:{kan:'dead',gen:'weak',zhen:'strong',xun:'strong',li:'peak',kun:'weak',dui:'trap',qian:'trap'},details:{natalPalace:"xun",element:"wood",originalDirection:"SE",luoShuNumber:"4",branches:"\u8fb0 Chen (Dragon), \u5df3 Si (Snake)",auspiciousness:"Auspicious",symbols:"knowledge, academics, wisdom, humility, etiquette",people:"teachers, mentors, elders, philosophers, psychologists",places:"museums, libraries, schools, temples, forests, gardens",things:"exams, books, cultural items, liver, eyes, nutrition",suitable:'wealth, fame, seeking mentors, travel, construction, new projects, recovery, praying'},$body:'The Heavenly Assistant governs curiosity \u2014 the quest of man and his thirst for truth.  High in the heavens, the Heavenly Assistant guards over the vast library of all knowledge mankind has ever and will ever know.  When utilized properly, this star grants access to ideas on dimensional planes that one can rarely reach.  Those born with the Assistant have the potential to become the greatest problem solvers for the world.  They are progressive philosophers who can see solutions others generally miss.  Their mark on history will be their contribution to unravelling the unknowns of their era.'},bird:{$dict_noun:['center','harmony','positivity'],strength:{kan:'weak',gen:'strong',zhen:'trap',xun:'trap',li:'dead',kun:'strong',dui:'peak',qian:'peak'},specialInteraction:{},palaceInteraction:{kan:"compelled",gen:"harmony",zhen:"countered",xun:"countered",li:"produced",kun:"harmony",dui:"produce",qian:"produce"},details:{natalPalace:"center",element:"earth",originalDirection:"Center",luoShuNumber:"5",branches:"\u672a Wei (Goat), \u7533 Shen (Monkey)",auspiciousness:"Very Auspicious",symbols:"wealth, leadership, flight, honesty, kindness",people:"boss, pilots, government leaders, property owners, officers, noblemen",places:"sky, open land, buildings, skyscrapers",things:"big things, head, machines",suitable:'new career, moving homes, wealth, fame, longevity, seeking recovery, spiritual enlightenment'},$body:'The Heavenly Bird governs unity.  The only star located in the central palace, the Bird represents the purity of mind, body, and spirit.   It emits a force of interconnectedness, and those who wield its powers can bring people together and accomplish monumental achievements.  The Heavenly Bird naturally attracts noble people to join one\u2019s cause and is highly preferred for use in business and new ventures.  The Bird resides in the center of the social circle and is the intermediary among all other entities.  Those born with the Bird find an innate ability to mediate and resolve conflicts with little effort.'},heart:{$dict_noun:['power','compassion','execution'],specialInteraction:{gen:"grave",xun:"fan yin",qian:"fu yin"},palaceInteraction:{kan:"produce",gen:"produced",zhen:"compelled",xun:"compelled",li:"countered",kun:"produced",dui:"harmony",qian:"harmony"},strength:{kan:'peak',gen:'dead',zhen:'weak',xun:'weak',li:'trap',kun:'dead',dui:'weak',qian:'weak'},details:{natalPalace:"qian",element:"metal",originalDirection:"NW",luoShuNumber:"6",branches:"\u620c Xu (Dog), \u4ea5 Hai (Pig)",auspiciousness:"Very Auspicious",symbols:"leadership, courage, success, adaptation, intelligence, recovery",people:"commander, thinker, doctor, academic, healer",places:"corporate headquarters, leader station, hospitals, control centers",things:"healthy things, treasures, valuables, sunshine",suitable:'health recovery, finding mentors, leading a team, recruiting, proactive actions'},$body:'The Heavenly Heart governs leadership \u2014 the courageous captain who leads his people into the vast unknown.  As the most auspicious of the Nine Star, this star imbues the leader with the active power to command as well as the gentle compassion to understand others.  This star strikes the perfect balance of firmness and softness.  The Heart Star carries with it the essence of longevity, honor, and prosperity.  Those born with this star possess the sensitivity to connect with their tribe, giving the tribe a magical source of healing power. Respect arrives naturally due to their altruistic nature for the group.'},pillar:{$dict_noun:['chaos','conflict','courage'],specialInteraction:{gen:"grave",zhen:"fan yin",dui:"fu yin"},palaceInteraction:{kan:"produce",gen:"produced",zhen:"compelled",xun:"compelled",li:"countered",kun:"produced",dui:"harmony",qian:"harmony"},strength:{kan:'peak',gen:'dead',zhen:'weak',xun:'weak',li:'trap',kun:'dead',dui:'weak',qian:'weak'},details:{natalPalace:"dui",element:"metal",originalDirection:"W",luoShuNumber:"7",branches:"\u9149 You (Rooster)",auspiciousness:"Mild Inauspicious",symbols:"disruption, betrayal, loss, conflicts, battles",people:"broken soldier, police officer, lawyer, professor",places:"courtrooms, marshes, cold areas",things:"fragile items, glass, pottery, household items, lung, mouth",suitable:'recovery, evasion, hiding, conserving energy, privacy, planning'},$body:'The Heavenly Pillar governs righteousness \u2014 the expressionless soldier. One who looks forward with one objective in mind \u2014 to fight for what he believes in.  The Pillar represents the firmness of principle.  Principle does not bend.  Justice does not sway.   Due to their competitive and ambitious nature, individuals with the Pillar are often too stubborn and straightforward to identify all opportunities ahead.  Blazing ahead could cause destruction, but they often feel such damage is necessary to achieve a meaningful result.  They feel it is an inner duty to be socially responsible, and they will strive to master all skills necessary to push for their cause.'},ambassador:{$dict_noun:['support','vitality','progress'],specialInteraction:{gen:"fu yin",xun:"grave",kun:"fan yin"},palaceInteraction:{kan:"compelled",gen:"harmony",zhen:"countered",xun:"countered",li:"produced",kun:"harmony",dui:"produce",qian:"produce"},strength:{kan:'weak',gen:'strong',zhen:'trap',xun:'trap',li:'dead',kun:'strong',dui:'peak',qian:'peak'},details:{natalPalace:"gen",element:"earth",originalDirection:"NE",luoShuNumber:"8",branches:"\u4e11 Chou (Ox), \u5bc5 Yin (Tiger)",auspiciousness:"Mild Auspicious",symbols:"dedication, honesty, trust, celebrations, perseverance, support",people:"mentors, officers, businessmen, successful people, noblemen",places:"farms, real estate, business centers, mountains, conference rooms",things:"money, gifts, nose, spleen",suitable:'new job, wealth, fame, marriage, partnerships, investing, learning, studying'},$body:'The Heavenly Ambassador governs progress.   For every event comes change.  For every creation comes end.  The Ambassador presides over the growth and decay of all events.  It is an intensely auspicious star which can provide one with resources and assets to continue advancing forward.  One who utilize this star properly will find that support and aid is always at the side \u2014 one will not have to adventure alone.  This star is particularly favored for business, war, and education. Those born with the Ambassador star will be relentlessly resourceful as they can find utility and value in any tool available to them.'},hero:{$dict_noun:['courage','action','impulsivity'],specialInteraction:{kan:"fan yin",li:"fu yin",qian:"grave"},palaceInteraction:{kan:"countered",gen:"produce",zhen:"produced",xun:"produced",li:"harmony",kun:"produce",dui:"compelled",qian:"compelled"},strength:{kan:'trap',gen:'peak',zhen:'dead',xun:'dead',li:'strong',kun:'peak',dui:'weak',qian:'weak'},details:{natalPalace:"li",element:"fire",originalDirection:"S",luoShuNumber:"9",branches:"\u5348 Wu (Horse)",auspiciousness:"Neutral",symbols:"explosiveness, accidents, fame, attention",people:"perfectionists, aggressive people, businessmen, attention seekers",places:"shopping malls, cinemas, stage",things:"entertainment, luxury items, heart, eyes",suitable:'networking, socializing, having fun, popularity, gaining charisma'},$body:'The Heavenly Hero governs courage.  As one of the two invisible stars of the Big Dipper, it is said that whoever can see this star will lead a life of prosperity, safety, and longevity.  This star exhibits an energy signature of confidence and power.  It is the source of the human ego and provides a positive charge to man\u2019s endeavors.  Those born with the Hero are seekers of new experiences and live life on the edge of tomorrow.  They will enter the darkness with no hesitation, lighting a fire for those behind to follow.'}};o.spirits={chief:{$dict_noun:['leader','protection','virtue'],details:{natalPalace:"kan",element:"earth",number:"1, 8",auspiciousness:"Very Auspicious",symbols:"leadership, integrity, peace, bliss, efficiency, success, optimism, clarity",people:"boss, noblemen, famous people, officer, priest, celebrity",places:"comfortable places, cities, sunny areas",things:"high quality items, genuine goods, nutritious foods",suitable:'Anything and everything. Career, wealth, fame, marriage, childbith, travel, learning, etc...'},$body:'The Chief \u2014 the First \u2014 is the commander of the universal realm and the head of the Nine Spirits.  A direct manifestation of the Tao itself, the Chief is the source of ten thousand things \u2014 and from it, life springs into existence.  Where the Chief walks, flowers blossom into prosperity.\n\nThe Chief is depicted by an Emperor who possesses the natural qualities of righteousness, justice, and honor.  People follow him because he inspires and instills the pinnacle of integrity.\n\nOne who possesses the guardian of the Chief is said to be invincible to negative energies, forever protected by the source of the divine itself till the end of time.  With great power comes great responsibility, and the Chief must fulfill his destiny to bring positive guidance to the world.'},snake:{$dict_noun:['supernatural','craft','sense'],details:{natalPalace:"gen",element:"fire",number:"2, 8",auspiciousness:"Very Inauspicious",symbols:"distrust, cunning, evil, betrayal, rumors, gossip, deception, disloyal, fickle",people:"deceptive people, tricksters, mentally ill people",places:"tunnels, underground, graveyards, sick places",things:"nightmares, hidden objects, handcuffs, poison, heart",suitable:'gossip, rumors, deceit, manipulation, changing ideas'},$body:'The Snake emanates from the fire the qualities of truth and fantasy \u2014 of what is reality or a dream.  It is the spirit intertwining mystery and complexity.  When the Snake slithers into being, the known becomes the unknown, fact becomes fiction, and distortion becomes reality.\n\n The Snake is depicted by a mystical sorcerer with the ability to sense nearby energies and connect to the emotional tunnel of others.  Legend says that those with the Snake can influence the weather.\n\nOne who possesses the spirit of the Snake finds the ability to manipulate the world using enhanced abilities of cunningness and wit, sharpness and speed.  One must be careful not to fall to the dark side, for the abilities of the Snake can often be too powerful and alluring for the individual to handle.'},moon:{$dict_noun:['curiosity','shadow','softness'],details:{natalPalace:"zhen",element:"metal",number:"4, 9",auspiciousness:"Mild Auspicious",symbols:"secrecy, darkness, proprietary knowledge, esoteric information, concealment",people:"strategists, intuitives, spies, philosophers, magicians",places:"libraries, study rooms, swamps, caves, tunnels, forts",things:"ulterior motives, armies, knives, psychadelics",suitable:'strategy, planning, hiding, learning new things, studying'},$body:'When the sun descends, the Moon rises as the mythical spirit of shadow and mystery.  It is the river of the great unknown \u2014 drifting, wandering, and forever seeking.\n\nThe Moon is depicted by a wise sage with an uncontrollable desire for answers to his existence.  Of the Nine Spirits, the Moon possesses the deepest aspiration for knowledge \u2014 especially secret, unattainable knowledge.  With knowledge comes satisfaction and power \u2014 and it is through this path that the Moon finds his destiny.\n\nThose with the spirit of the Moon have the ability to understand esoteric subjects without a rational explanation.  Their mind is like water, exploring the edges of the hidden cave and hoping to find the treasure that is truth.  With great intuition, they are able to discover forbidden secrets that others cannot and will never obtain.'},harmony:{$dict_noun:['unity','feeling','peace'],details:{natalPalace:"xun",element:"wood",number:"6, 7",auspiciousness:"Mild Auspicious",symbols:"relationships, protection, peace, cooperation",people:"matchmakers, middlemen, salesmen, helpers, organizers",places:"get-togethers, marriages, lakes, grasslands",things:"clothes, gifts, food, flowers",suitable:'meeting new people, creating positive relationships, marriage, social events, negotiations, peace'},$body:'The spirit of Six Harmony is the embodiment of purity and unity.  Whenever darkness spreads across the land, Six Harmony blooms to bring light and optimism once again.\n\nSix Harmony is depicted as a graceful maiden at a family gathering spreading the aura of blessing and love.  They are social butterflies who can emphasize and connect with anyone they come across.  Legend says that during the great Heavenly Battles, only the Six Harmony was able to sacrifice herself and restore peace and serenity to the world.\n\nOften associated with happiness and positivity, the Six Harmony possesses an innate ability to mediate and mend relationships.  They are masters at balance \u2014 being the only spirit who can create win-win situations in all cases.  They are truly selfless individuals, because they understand that their existence is only a small part of the whole.'},hook:{$dict_noun:['ancestry','land','conflict'],details:{natalPalace:"li",element:"earth",number:"5",auspiciousness:"Very Inauspicious",symbols:"disturbance, conflicts, malicious behavior, gossip, secrecy",people:"criminals, thieves, terrorists, power-seeking individuals",places:"cloudy areas, underground captivity, roadss, dark areas",things:"sharp objectss, harmful objects, blood, lung, bacteria",suitable:'psychological manipulation, hypnosis, litigation, intimidation'},$body:'At the crown of Polaris, one will find the Grappling Hook overlooking earth\u2019s passage of time.  This magnificent spirit governs the ancestral past of man, slowly threading the fabric connecting the past and the present.\n\nLegend says that the Hook is a lone warrior presiding over all wars and conflicts of the human world.  The Hook strives to win at all costs, utilizing its vast library of history to systematically plan a route to success.  Due to their reputation for being merciless and vengeful, they are often feared in the mythical realm.\n\nThose who possess the spirit of the Hook have the innate ability to understand the cause and effect of all events.  They are connected to the roots of nature and have an uncanny power to heal and rejuvenate via natural foods and herbs.'},tiger:{$dict_noun:['stamina','force','wind'],details:{natalPalace:"li",element:"metal",number:"7",auspiciousness:"Very Inauspicious",symbols:"dominance, strength, conflicts, disasters, violence",people:"fighters, military, athletes, competitors, soldiers, executioners",places:"military zones, fighting arenas, battlefields",things:"weapons, hammers, knives, bones, bladder, lung",suitable:'gaining stamina, engaging in battle, winning in conflict'},$body:'The spirit of White Tiger guards over the vessel of energy used by all forms of life in the universe.  When summoned properly, this spirit can unleash a boundless force capable of either complete annihilation or creation.\n\nThis spirit is depicted as a beast of the jungle which has managed to survive for hundreds of years, bearing in a near-immortal being dusted in white snow.  The White Tiger are revered by the creatures of the land and sky, for they know that it can transform from elegance to viciousness in the blink of an eye.\n\nThose with this spirit will discover an unlimited source of stamina to achieve prolific achievements.  They are able to endure pain and hardships at magnitudes far beyond the average being.  The White Tiger acts and does not speak; fights and does not surrender; rises and does not fall.'},phoenix:{$dict_noun:['story','perspective','transmission'],details:{natalPalace:"kun",element:"fire",number:"4",auspiciousness:"Very Inauspicious",symbols:"gossip, rumors, arguments, betrayal, backstabbing",people:"scholars, litigators, debators, intellectuals, talkers",places:"courtroom, libraries, radio stations, windy places",things:"books, statements, documents, mouth, ear",suitable:'influencing others, spreading ideas, marketing, '},$body:'The Red Phoenix is the guardian of communications and transmissions.  As ideas rise from the fire and spread with the wind, the Phoenix oversees their propagation into the cultural essence of civilization.\n\nThis fabled creature radiates an ambience of inspiration, and it is through this ambience that generations of humanity have been moved and swayed.  The legendary Cao Cao of the Three Kingdoms commanded a charismatic voice that neither ally nor foe could ignore, escalating him to the highest spheres of power.\n\nWith the tongue of the Phoenix, one can turn lies into reality, the distasteful into the beautiful, and the ordinary into the extraordinary.  Arguments are rarely lost; reputation is rarely shattered.  He who is born with this spirit can persuade his peers into thinking and acting in any way he so desires.'},tortoise:{$dict_noun:['magic','darkness','influence'],details:{natalPalace:"kun",element:"water",number:"9",auspiciousness:"Very Inauspicious",symbols:"hidden objectives, damage, broken promises, corruption, espionage, unethical behavior",people:"criminals, politicians, schemers",places:"underground places, casinos, muddy areas",things:"alcohol, money, drugs, kidney, bones",suitable:'psychological warfare, influencing others emotions, hidden agendas'},$body:'When the clouds gather overhead, the mysterious warrior emerges from its shell.  The spirit of the Dark Tortoise is the master of wizards and is able to mesmerize the motivations of all life on earth.\n\nThis mystical creature is legendary for its portrayal as the lord of the sea in the novel Journey to the West.  It is a deity so powerful that some claim simply being in its presence is akin to entering a tunnel of hypnosis.\n\nWhen properly trained, the Black Tortoise can sense the emotions, desires, and vibrations of others.  The ability to plant seeds into the subconscious minds has given the Black Tortoise an undeserved reputation of dark sorcery.  As such, one must be careful to ensure that such arcane magic is only used to help others in a positive way.'},earth:{$dict_noun:['solidity','nourishment','balance'],details:{natalPalace:"dui",element:"earth",number:"2, 8",auspiciousness:"Mild Auspicious",symbols:"stabiblity, respect, calmness, honnesty",people:"workers, guards, planters, dedicated people",places:"casinos, farms, banks, property, houses, stable areas",things:"side money, side jobs, real estate income",suitable:'windfall money, avoiding publicity, remaining hidden, passive income'},$body:'The Nine Earth is the gentle mother of nature responsible for the stability of life on earth, ensuring that chaos and order remains in balance.  This spirit has watched over earth\u2019s resources since the beginning, closely nurturing its child from generation to generation.  In the distant past, the Nine Earth was appreciatively worshipped for her ability to bring water and crops to the people.  The Nine Earth is depicted as a perfect circle \u2014 a symbol of eternal life and death.\n\nAs the most benevolent spirit of all, individuals who possess Nine Earth places the prosperity of others above themselves.  They are grounded personalities who take matters one step at a time, preferring not to shake the foundation that has been carefully constructed over time.  The Nine Earth instills calmness and compassion into the individual, a gift that brings along a healthy body and long life.'},heaven:{$dict_noun:['vision','destination','truth'],details:{natalPalace:"qian",element:"metal",number:"1, 6",auspiciousness:"Auspicious",symbols:"visionary, intuition, future, wealth, fame, beauty",people:"fatherly figure, doctor, sage, philosopher, leader",places:"cities, schools, religious areas",things:"trees, clocks, medicine, mist, intestines, hair",suitable:'imagining the future, starting new plans, meeting mentors, engaging in partnerships, wealth, fame'},$body:'The Nine Heaven rules over the skies that man cannot touch.  S/he is the ultimate symbol of man\u2019s dreams and aspirations \u2014 of unlimited potential and optimistic transformation.  While man experiences the present time on earth, the Nine Heaven governs the possible realities of the future.\n\n5000 years ago, when he Yellow Emperor was losing the final battle with the invincible tyrant Chi You, legend has it that the Goddess of Nine Heavens came down into the Emperor\u2019s dream to teach him what is now known as the most powerful divination tool known to man \u2014 Qi Men Dun Jia.  With this technique, the Yellow Emperor was able to predict the enemy\u2019s next action, winning the war in his favor.\n\nToday, those who possess the spirit of Nine Heaven are known to be experiencers of synchronicity and visionaries of alternate dimensions.  They can project vivid details of probable realities in their subconscious minds, manifesting those realities that they desire.  As the only spirit with this self-fulfilling ability, the magician of Nine Heaven must be careful what he wishes for.'}};o.displayTerminology={0:{spirit:{chief:['chief','\u7b26'],heaven:['heaven','\u5929'],earth:['earth','\u5730'],tortoise:['tortoise','\u7384'],hook:['hook','\u9673'],phoenix:['phoenix','\u96c0'],tiger:['tiger','\u864e'],harmony:['harmony','\u5408'],moon:['moon','\u9670'],snake:['snake','\u86c7']},star:{grass:['grass','\u84ec'],ambassador:['ambassador','\u4efb'],destructor:['destructor','\u6c96'],assistant:['assist','\u8f14'],hero:['hero','\u82f1'],grain:['grain','\u82ae'],pillar:['pillar','\u67f1'],heart:['heart','\u5fc3'],bird:['bird','\u79bd']},door:{rest:['rest','\u4f11'],life:['life','\u751f'],harm:['harm','\u50b7'],delusion:['delusion','\u675c'],scenery:['scenery','\u666f'],death:['death','\u6b7b'],fear:['fear','\u9a5a'],open:['open','\u958b']}},1:{spirit:{chief:['CEO','\u7b26'],heaven:['heaven','\u5929'],earth:['earth','\u5730'],tortoise:['warrior','\u7384'],tiger:['tiger','\u864e'],phoenix:['bird','\u96c0'],hook:['polaris','\u9673'],harmony:['harmony','\u5408'],moon:['moon','\u9670'],snake:['snake','\u86c7']},star:{grass:['seed','\u84ec'],ambassador:['official','\u4efb'],destructor:['destroy','\u6c96'],assistant:['assist','\u8f14'],hero:['hero','\u82f1'],grain:['seed','\u82ae'],pillar:['pillar','\u67f1'],heart:['heart','\u5fc3'],bird:['dove','\u79bd']},door:{rest:['rest','\u4f11'],life:['growth','\u751f'],harm:['injury','\u50b7'],delusion:['delusion','\u675c'],scenery:['outlook','\u666f'],death:['death','\u6b7b'],fear:['shock','\u9a5a'],open:['open','\u958b']}},2:{spirit:{chief:['chief','\u7b26'],heaven:['sky','\u5929'],earth:['earth','\u5730'],tortoise:['tortoise','\u7384'],tiger:['tiger','\u864e'],phoenix:['bird','\u96c0'],hook:['worm','\u9673'],harmony:['combo','\u5408'],moon:['moon','\u9670'],snake:['snake','\u86c7']},star:{grass:['shower','\u84ec'],ambassador:['trust','\u4efb'],destructor:['dash','\u6c96'],assistant:['aid','\u8f14'],hero:['grace','\u82f1'],grain:['tie','\u82ae'],pillar:['column','\u67f1'],heart:['heart','\u5fc3'],bird:['beast','\u79bd']},door:{rest:['rest','\u4f11'],life:['grow','\u751f'],harm:['hurt','\u50b7'],delusion:['stop','\u675c'],scenery:['scene','\u666f'],death:['death','\u6b7b'],fear:['fear','\u9a5a'],open:['open','\u958b']}}};o.victories={light:{$dict_verb:['Receive','Pull'],school:'contemporary',anchor:'Chief (natal star)',description:'The day where Life Door and Heaven Spirit (of day and month charts) enter your Light Palace.',activation:'When Life and Heaven separately appear in Day and Month chart [or] when Life and Heaven appears in Day Chart.'},force:{$dict_verb:['Initiate','Push'],school:'contemporary',anchor:'Life Door',description:'The day where Heaven Spirit and Chief Spirit (of day and month charts) enter your Force Palace.',activation:'When Chief and Heaven separately appear in Day and Month chart'},blessing:{$dict_verb:['Request','Exchange'],school:'contemporary',anchor:'Heaven Spirit',description:'The day where Chief Spirit and Heaven Spirit (of day and month charts) enter your Blessing Palace.',activation:'When Life and Chief separately appear in Day and Month chart [or] when Life and Chief appears in Day Chart.'}};o.formations={jia:{jia:{rating:0,name:'forest formation',nick:'jungle formation',note:'Steady action leads to steady progress.  Suggested course of action is passivity.  Keeping the status quo is vital.',desc:"One will waddle through various obstacles when he or she is proactive. As such, it is advisable to remain passive. Everything will fare well if you keep calm; what the heart wishes the hands will accomplish"},yi:{rating:0,name:'green dragon combines spirit',nick:'green dragon with spirit',note:'Yi Wonder aids the Jia.  Plans will unfold as they should.  (if Door is inauspicious, obstacles may appear)',desc:"Auspicious outcome. Denotes positive energy and great strength. However when the Door is inauspicious, the energies would turn inauspicious two folds."},bing:{rating:1,name:'green dragon returns',nick:'green dragon returns',note:'Uninterrupted progress on all fronts.  Positive energy unfolds in all spectrums.  (condition: Six Striking Penalty causes negative effects)',desc:"Extremely auspicious. Denotes positive outcome in all endeavours. However, when it falls on houses that represent Entering Grave \u5165 \u5893 or Striking Punishment, this combination can be extremely undesirable."},ding:{rating:1,name:'wood fire brilliance formation',nick:'wood and fire brilliance',note:'Ding Wonder illuminates the way for Jia. Suitable for seeking help, advancing strategy, and finding recognition.  Efforts shall not go to waste.',desc:"Good for meeting Noble people and receiving support. Excellent combination for career pursuits and seeking fame. Also good for promotion and getting support from superiors. When it falls on Grave \u5893 location, it will be compelled with all previous positive effects nullified."},wu:{rating:0,name:'shining green dragon formation',nick:'shimmering dragon',note:'Earth and Heaven clash into chaos, depicting neutral outcome and shattered progress.',desc:"Heaven counters Earth, pulling in unwanted outcomes. This emulates the effects of Jia-Jia \u7532\u7532combo, which denotes unsuccessful pursuits, lonesome ventures and lack of support."},ji:{rating:-1,name:'nobleman enters prison',nick:'official enters prison',note:'Jia is trapped underneath the pressure.  Allies and mentors will cause confusion for strategic action.  Problems may arise in work or personal matters.',desc:"Due to lack of support from superiors, this formation is not favorable for either official or personal affairs. Even those who support you will meet with trouble. As such, expect difficulties in whatever you\u2019re embarking on. Misleading instruction and command by others amplify this negative streak."},geng:{rating:-1,name:'leader flying palace',nick:'general flying palace',note:'Emotional distress as progress may reverse course.  Competition arises and seek to counter your objectives.',desc:"Auspicious matters turning the other way round, and continue to disintegrate. The situation is growing murkier and you are left feeling helpless. You seem to meet with rivals or challengers everywhere, and your feeling of fear and anxiety only attest to this inauspicious stride."},xin:{rating:-1,name:'green dragon broken feet',nick:'green dragon breaks leg',note:'The great dragon loses its roots.  Generallly inauspicious, but can be nullified with auspicious doors. One should pay attention to the foundation of the matter.',desc:"Denotes cutting away your foundation or removing your support. It is only with auspicious Doors you can make plans to escape or avoid a confrontation with your enemies. Meet with negative Doors, however, one may incur major cut-backs and loss of fortune. Also, be aware of injuries relating to your feet."},ren:{rating:-1,name:'green dragon enters heavenly prison',nick:'green dragon captured in prison',note:'The great dragon is drowned in water. Confusion will arise, followed by mixed transmission of information and communication.  Important details are lost and matters may stagnate.',desc:"Not good for romance-related activity. If proceed, you will find that your good intentions being misinterpreted. Nothing in terms of communication and relationship would go well. Obstacles and stagnancy will drag down everything you do."},gui:{rating:0,name:'green dragon elegant seal',nick:'green dragon elegant seal',note:'A neutral formation that is dependent on the auspiciousness of the doors.  This formation is related to enemies and rivals.',desc:"You can outwit your competitors, and your idea will bear fruitful results. Auspicious Doors in sight, this formation will bring good fortune. Without the presence of inauspicious Doors, however, this formation can cost you unusual setbacks and unpleasant affairs and or stagnant progress."}},yi:{jia:{rating:0,name:'maxes yin supress yang',nick:'yin rises yang falls',note:'Roots from Heaven meets Tree on Earth. Smooth sailing and steady progress.  Fortified by allies.  Meeting inauspicious Door results in progress blockage.  This formation is related to those around you.',desc:"This formation also known as Roots Attacking Jia \u85e4\u863f \u64ca\u7532. Everything will be successful and well, adding brilliance to your present splendor. There will be excellent support from friends and related parties. When this formation is compelled by inauspicious Door, it denotes fortune loss and injuries due to problems brought about by people close to you."},yi:{rating:0,name:'day noble fu yin',nick:'day wonder fu yin',note:'As a situation of stagnation, one should not seek advancement or pursue gain.  Risk and volatile decisions should be avoided.',desc:"It is not advisable to approach your superior or important contacts for a meeting or discussion. Not advisable also to pursue fame or status or to take risk at this time. Your condition is not changing at a speed that you are comfortable with. Do not take unnecessary risk as you should remain in your sphere of influence."},bing:{rating:1,name:'noble crest in position',nick:'wonder crest established',note:'Exciting and uplifting positivity.  Good news shall come.  Auspicious Doors shall result in actualization of desires.  Inauspicious Doors shall result in disconnect or separation.',desc:"This combination denotes promotion and celebratory events. At the location of auspicious Stars, you can expect good news in terms of a promotion. Auspiciousness abound if auspicious Door is present, as all your endeavors will go well and the outcome that is desired will be materialized. At inauspicious Door or inauspicious Star, however, one should brace themselves for a separation."},ding:{rating:1,name:'noble assisting jade maiden',nick:'wonder assists jade lady',note:'Positive for entering into new relationships and partnerships.  Wonder assists Jade Lady to carry out plans.  Execution in career-related situations shall be effective.',desc:"Good for signing contract or deals, Noble Assisting denotes well received ideas and strategy that will be executed effectively and that everything goes well. Very good for carrying out administrative work and examination."},wu:{rating:0,name:'noble enters heavenly door',nick:'wonder enters sky gate',note:'Inauspicious for Male. Auspicious for Female. Positive for concealed planning and strategizing.  Working behind the scenes will be enhanced with auspicious Doors.  Inauspicious Doors may result in obstruction, loss, or delay.  Associated with efficient rejuvenation, recovery, and leisure.',desc:"Favors female. Male counterpart that opts for this formation should be wary as it is inauspicious for them. Beneficial for scheming and initiating a stealth plan. Whenever auspicious Door is present within this formation, you can execute your plans effectively. With an inauspicious Door, however, brace yourself for wealth loss or bodily harm. This formation is good for meditating, embarking on a leisure travel and getting married."},ji:{rating:0,name:'day noble enters mist',nick:'day wonder wanders through mist',note:'Wonder walks path and finds cloud. What lies ahead is uncertain and out of sight.  Suggested action is careful progression, stillness, and patience.',desc:"This formation denotes uncertainty. The path ahead is unclear or obstructed. Best to conquer the uncertainty by keeping calm and still. Develop inner peace and conquer the unyielding with yielding."},geng:{rating:-1,name:'day noble punishment',nick:'day wonder punished',note:'Wonder meets enemy Metal.  Strained relationships, attacks on resource, conflicts in progress.',desc:"Denotes possible lawsuit and losing of wealth. Relationships become estranged and communications become strained."},xin:{rating:-1,name:'green dragon escape',nick:'green dragon escape',note:'Yi Wonder (Green Dragon) meets White Tiger (Xin). This formation suggests separation of Yi and Xin.  Wife may leave husband.  Subordinates may leave superiors.  Those under control may detach from existing bonds.',desc:"Yi \u4e59is Green Dragon \u9752\u9f8d and Xin \u8f9b is White Tiger \u767d \u864e. Because Yi \u4e59 Wood can escape when opposed and controlled by Xin \u8f9b Metal, this formation is thus named Green Dragon Escaping \u9752 \u9f8d\u9003\u8d70. This denotes inauspiciousness, especially in marriage as wife is likely to walk out on the husband. Even in work, subordinates or staff will leave your employment. In the presence of inauspicious doors, this formation may even denote abduction or death of pets from animal abuse."},ren:{rating:-1,name:'day noble enters earth',nick:'day wonder joins earth',note:'Revolution is on the horizon.  Conflict between the fresh and the old.  Rebellions between the student and the master.  Advisable to hold situation with steady hands.',desc:"Young might rebel against the old, servants turn against their master, and one might be dragged into a messy tangle of lawsuit and constant troubles. Advisable to stick to the tried-and-tested rules as it is not favourable for taking shortcuts or risk. When meet with negative Doors, Stars and Deities, the situation may worsen as life-threatening dangers can be expected."},gui:{rating:0,name:'elegant seal meets star',nick:'star meets elegant seal',note:'Flower meets Mist.  Traditionally regarded as a good formation for rejuvenation, cultivation, recovery, and self improvement.',desc:"This formation denotes going into seclusion in favor of self-cultivation or self- reflection. It denotes meditation and spiritual practices."}},bing:{jia:{rating:1,name:'flying bird fall into cave',nick:'flying bird falls into cavern',note:'Tree mothers Sun.  In this formation, Sun returns to Mother, indicating natural, uninterrupted progress.  One of the most highly desired formations of the kingdom.',desc:"Jia \u7532 is the mother (Resource Element) of Bing Fire \u4e19\u706b. When Bing Fire returns to the mother, it emulates the act of a bird flying back to its cave; hence the name, Flying Bird Fall into Cave \u98db\u9ce5\u8dcc\u7a74. This denotes that everything falls into place naturally and well; you will succeed without having to stress yourself too much. Everything goes well; you will gain both fame and wealth."},yi:{rating:1,name:'bright sun and moon',nick:'sun and moon shines',note:'Sun shines on Flower. Wonders gather together to move plans forward.',desc:"Both official and personal affairs are well. All you need is better self control. You can execute your plans now."},bing:{rating:-1,name:'month noble rebelling officer',nick:'month wonder rebelling officer',note:'Sun overshines the situation. Possible conflicts and disagreements. Associated with legal, documentation, and administrative problems.',desc:"Possible legal issues or lawsuits arising due to contractual problems. Be careful of misplacing important documentation and evidence. In work, be careful of how you handle your important data."},ding:{rating:1,name:'month noble red phoenix',nick:'phoenix and month wonder',note:'Sun and Flame guides the way. Associated with meeting noble people, receiving optimistic energy and uplifting support.  Illumination and inspiration surrounds the situation.',desc:"Denotes receiving help from a Noble person. This formation also indicates receiving approval or support in writing. Where this formation meets with the Life Door, it forms the Heavenly Dun \u5929\u9041 formation. This combination favors self-cultivation and for supporting or inspiring others."},wu:{rating:1,name:'flying bird fall into cave',nick:'flying bird falls into cavern',note:'Earth reflects Sun, returning to Tree.  Great outlook for success, advancement, and promotion.',desc:"Same as Bing \u4e19 \u2013 Jia \u7532 combo. Perfect resolution for most matters and you\u2019re likely to achieve both fame and wealth."},ji:{rating:0,name:'great rebel enters punishment',nick:'rebel receives penalty',note:'Sun dries Soil.  A neutral formation suitable for agreements, travel, and ordinary matters. With Auspicious Door comes stability.  With Inauspicious Door comes risk.',desc:"It indicates the possibilities of receiving civil support. This combination is auspicious only when meet with Auspicious Doors. It is good for signing contract or pursuing long distance travel. Where it meets with an inauspicious door, this formation will bring about danger and health hazard."},geng:{rating:-1,name:'shimmering enters great white',nick:'shimmering light',note:'Sun reveals Iron.  Inauspicious formation indicating stress in relationships related to possessions and ownership.',desc:"Highly unfavorable formation. It denotes crumbling family ties or relationships. Loss of belongings or ownership, including possible loss of wealth are imminent."},xin:{rating:1,name:'sun moon meeting',nick:'sun unites moon',note:'Sun reveals Gold. Positive formation associated with uninterrupted progress, aid, and allies.',desc:"It represents positive outcome stemming from sound strategy. A good medical personnel will appear to cure your illness."},ren:{rating:-1,name:'fire enters heavenly web',nick:'heavenly web with fire',note:'Ocean controls the Sun. Supportive of Host.  Not supportive of guest.  Reputation of guest at stake.  Host finds obstacles originally not surfaced.  Stagnation shall result if Inauspicious Door is present.',desc:"This formation is more supportive of the Host than of Guest hwo may become the subject of some negative publicity which will impact upon his or her reputation.  Host may also encounter problems, however, if combination meets with inauspicious door resulting in the attitudes of others becoming a stagnant force.  Bing is here opposed and countered by Ren."},gui:{rating:-1,name:'elegant seal rebelling officer',nick:'officer with elegant seal',note:'Sun covered by Mist.  Clarity dissipates.  What is to be understood ceases to be comprehended. Words and ideas dissolve into alternate meanings.',desc:"This formation suggests an inauspicious outlook.  There could be struggle to be understood, particularly through the written word, and even with the best of intentions one may become the subject of unjust accusations.  Be very wary about the way one puts his or her words across."}},ding:{jia:{rating:1,name:'green dragon salivating the pearl',nick:'green dragon with pearl',note:'Fire lights the way.  Associated with positive future and hopeful returns.',desc:"Denotes a promotion and a bright future ahead. Possible increase in salary and income. A positive formation indicating auspicious outcomes."},yi:{rating:1,name:'heavenly flourish formation',nick:'heaven garden prospers',note:'Fire and Flower helps garden flourish.  Noble people shall appear.  Bliss and happy events come to light.',desc:"Indicates the possibilities of receiving help from Noble people, getting a promotion, and a happy marriage. What you sincerely seek, you shall receive."},bing:{rating:1,name:'star follows moon turn',nick:'star moon rotation',note:'Fire and Sun dance in harmony. Bliss and happiness shall come, but one shall not take it for granted.  With inauspicious Door, positive situation could soon dissipate.',desc:"Indicates possible promotion in career, but you should be mindful that extreme joy might beget sorrow. Everything goes smoothly as you have planned. However if there is a negative door, the positive situation could be short- lived. Where there are negative stars, you must hold back your celebration as your work is not finished. You may experience bigger loss because you cannot endure through minor setbacks."},ding:{rating:1,name:'noble enters great yin',nick:'yin greets wonder',note:'Two fires come together, wonder grows bright.  Positive situation and natural progress.  Advised to take advantage of the situation before fire burns out.',desc:"Although positive matters unfold naturally, you should not take things for granted. Be mindful of your actions. What is good right now, may not last very long."},wu:{rating:1,name:'green dragon turn bright',nick:'green dragon radiance',note:'Fire and Sun gather on Earth. Allies and mentors shall come to aid. Advised to take advantage of helpful people nearby.',desc:"Very auspicious formation. Denotes help from Noble people. Your task or goals will become easier with the help of others."},ji:{rating:-1,name:'fire enters grappling hook',nick:'hook captures burning flame',note:'Fire and Ash become one.  Associated with a third party interrupting progress. Advised to be cautious of external influences.',desc:"Negative love luck that said to involve a third party in the form of a female. As such, be mindful of treachery and deceit in relationship."},geng:{rating:-1,name:'hour structure',nick:'hour formation',note:'Fire meets Iron, conflict arises.  Blockages and setbacks reveal themselves.  Associated to obstruction in travel, communication, transmission, and plans.',desc:"This formation is also known as Jade Maiden Punishment Sha\u7389\u5973\u5211\u6bba Geng \u5e9a is the Deity of Obstruction, so travelers might not be able to carry on their journey because of blocked communication or obstructed path in travelling. Document and communication are blocked; while events and situations develop inconsistently."},xin:{rating:-1,name:'red phoenix enters prison',nick:'phoenix captured',note:'Fire captured by Gold. Conflict arises. Loss to both sides. Advised to take defense to prevent any losses.',desc:"Nothing goes well. What seems positive now will turn the opposite way later. This combination might cause destruction to both sides."},ren:{rating:1,name:'five deities mutual combine',nick:'five spirits peaceful combine',note:'Leading Ocean carries Fire.  Noble people shall appear.  Fairness and justice prevails.  At time of need, one finds hope.',desc:"Everything goes as you have intended. You will also receive help at the eleventh hour from a Noble person. For your lawsuits, a fair trial is expected."},gui:{rating:-1,name:'red phoenix diving water',nick:'phoenix dives into water',note:'Rain puts out Fire.  Plans blocked, ideas miscommunicated.  Intentions misperceived.',desc:"Nothing goes well, communication with others might be blocked or be hindered with obstructions. Your good intention is misconstrued and you are misunderstood as well. If there are negative Stars or Door, there\u2019s a possibility of being sued."}},wu:{jia:{rating:-1,name:'huge rock crushes wood',nick:'rock crushes wood',note:'Mountain falls on Tree. Movement is restricted.  Progress is obstructed.',desc:"Everything is obstructed. Think twice if you\u2019re planning any further advancement. It is better to lay low and stay passive."},yi:{rating:0,name:'green dragon combines spirit',nick:'green dragon unites spirit',note:'Flower climbs on Mountain. Indication of climbing, steady progress.  Associated with positive returns and profitable endeavors.',desc:"A Wu \u620a - Yi \u4e59 combo. Jia \u7532 and Yi \u4e59 meet at the East, which is the residence of the Green Dragon \u9752 \u9f8d. Hence the term Green Dragon Combines Spirit \u9752 \u9f8d\u5408\u9748. Highly favorable outcome for making progress and executing plans. It also denotes positive returns on your money. If meet with auspicious Doors, its positive effect would be doubled. But if meet with inauspicious Doors, the positive effects would be nullified."},bing:{rating:1,name:'green dragon returns',nick:'green dragon returns',note:'Mountain and Sun protects the Tree. One of the most auspicious formations, this suggests success on all fronts.',desc:"This formation is aptly called Green Dragon Protecting Leader \u9752\u9f8d\u9867\u9996 because Green Dragon \u9752\u9f8d Jia \u7532 Wood produces Bing \u4e19 Fire, and this combination indicates successful implementation of strategies for success and business. This is an extremely auspicious formation. If this formation Enters Grave \u5165\u5893 or is hit with a Striking Punishment \u64ca\u5211 formation, the positive event would be revoked in the end."},ding:{rating:1,name:'shining green dragon formation',nick:'green dragon shines',note:'Fire shines ahead. Tree produces Fire. Indicates success with surrounding entities, people, relationships, and situations. Indicates proper control of matters in the nearby vicinity. Associated with fame, wealth, and success.',desc:"This formation is aptly called Shining Green Dragon Formation \u9752\u9f8d\u5149\u8000 because Green Dragon \u9752\u9f8d Jia \u7532 Wood produces Ding \u4e01 Fire, and this combination indicates successful meeting with superiors and establishing important network and relationship with people of stature. It is also highly favorable for garnering fame and material success. Be mindful if it lands in a Graveyard location as it denotes trouble and trauma."},wu:{rating:-1,name:'fu yin',nick:'fu yin',note:'Mountain and Mountain blocks progress. Stagnation dictates current situation. Nothing shall move.',desc:"This formation is characterized as a Fu Yin\u4f0f \u541fstructure. It denotes that everything is stagnant and slow at this time. It is better to take time to cultivate the mind and rejuvenate the spirit. It is better to stay on the safe side, remember that passive is better than active at this time."},ji:{rating:-1,name:'nobleman enters prison',nick:'nobleman captured',note:'Mountain and Soil blocks progress. Associated with allies or helpers obstructed from your sights. Support and assistance shall be withdrawn, and strengt shall decrease.',desc:"Ji \u5df1 is derived from the Jia Xu \u7532\u620c pillar and Xu \u620c is the Grave \u5893 for Wu Earth \u620a\u571f. This formation can be interpreted as a sign that your Noble person or an individual who is able to help you has been convicted into prison or has been removed. This means you no longer have the backing or support you need. The situation is bad for both official and private affairs."},geng:{rating:-1,name:'leader flying palace',nick:'general flying palace',note:'Metal cut down roots. Associated with unexpected disasters, loss of direction, unsteady pace. Associated with worsening profits and health.',desc:"As the Lead Star, Jia \u7532 is most vulnerable to the clash from Geng \u5e9a Metal. As such, this formation is named Leader Flying Palace \u503c\u7b26\u98db\u5bae. It denotes derailing of plans and worsening situations, both due to the unforeseen or uncontrollable circumstances around. If situation were already bad, expect it to get worse. There is unlikely to be any profit from pursuit of business and even for health matters, and this negative streak follows when you\u2019re seeking medication from doctor. This formation also indicates a change of place. Even with auspicious Door, this formation will not turn for good, and things would worsen if it meets with inauspicious Door. All previous efforts will be in vain."},xin:{rating:-1,name:'green dragon broken feet',nick:'green dragon breaks leg',note:'Gold appears from beneath.  Structures dissolve into chaos, misunderstandings arise to cause confusion and blockage.  Associated with lack of efficiency.  Auspicious Doors shall negate negative consequences.  Inauspicious Doors indicate worsening situations or possible disasters.',desc:"As Xin \u8f9b Metal controls Jia \u7532 Wood and Zi \u5b50 clashes with Wu \u5348, this structure is named Green Dragon Broken Feet \u9752\u9f8d\u6298\u8db3. It denotes the breaking down of a structure or system; communication breakdown. Lots of misunderstanding or people unable to carry out their orders effectively or efficiently. If it is found at an auspicious Door the situation can be salvaged despite some setbacks. You may still look out for an opening in the situation. If it is located at an inauspicious Door, it denotes disaster, fortunes loss, or a broken foot or getting hurt."},ren:{rating:-1,name:'dragon enters prison',nick:'dragon captured',note:'Ocean water traps Green Dragon Tree.  Indicates the leader pressed against his will, with little options to move. Inability to act results in loss and decay.',desc:"As Ren \u58ec is the Heavenly Prison \u5929\u7262 and Jia \u7532 is the Green Dragon \u9752\u9f8d, this formation is named as Dragon Enters Prison \u9f8d\u5165 \u5929\u7262. This formation denotes struggle and losing faith and hope. Everything is damaged and money is lost."},gui:{rating:0,name:'green dragon elegant seal',nick:'green dragon meets elegant seal',note:'Rainwater falls on Green Dragon Tree. Neutral formation. Meeting Auspicious Door signals joy and satisfaction.  Meeting Inauspicious Door signals disappointment.  Associated with education and academics.',desc:"As Jia \u7532 is the Green Dragon \u9752\u9f8d and Gui \u7678 is the Heavenly Net or the Elegant Seal \u83ef\u84cb, this formation is named as Green Dragon Elegant Seal \u9752\u9f8d \u83ef\u84cb. The formation is neutral unless it is activated by an auspicious Door. It will then denote blessings and happiness. Favorable for scholarly pursuits."}},ji:{jia:{rating:0,name:'dog meets green dragon',nick:'green dragon greets companion',note:'Soil from above traps Tree. Operational efficiency is reduced.  Speed of progress hindered by obstacles and blockages.',desc:"This is an inauspicious formation. Everything is not proceeding smoothly with many obstacles and frustrations. Everything seems to be moving in slow motion and not being productive. If the formation lands on an auspicious Door, plans and strategies will go as you wish. You\u2019re likely to win favor from superiors as well. If it is located on inauspicious Door all efforts will be wasted."},yi:{rating:0,name:'hidden grave deity',nick:'spirit hides in tomb',note:'Soil entagle Roots. Indication of cloudy, unclear conditions ahead. Advised tread careful and take appropriate precautions.',desc:"As Xu \u620c is the Grave of \u4e59 Yi Wood, Ji \u5df1 is Earth Gate \u5730\u6236. As such, this formation is named as Hidden Grave Deity \u5893\u795e\u4e0d \u660e. This formation denotes that it is best to keep a low profile and stay away from attention. Everything is murky and unclear. Best to stay secluded or in hiding. Without clarity you cannot act. Hastiness brings disaster."},bing:{rating:-1,name:'fire rebelling earth door',nick:'earth gate repels flame',note:'Earth and Fire conflict. Associated with indecency, immorality, and lack of faith. Challenges will be presented.',desc:"This formation denotes fighting fire with fire; one needs to make a stand. For women, avoid obscenity and adultery. Nothing goes smoothly without obstacles and struggles. You should know that without struggle, there will be no progress."},ding:{rating:0,name:'red phoenix enters grave',nick:'phoenix burried in grave',note:'Fire trapped underneath.  If approach is not careful, indicates volatile changes, unexpected shifts in situation, breakdown of communication, and reckless action.',desc:"As Xu \u620c is a Fire Grave, this formation is named as the Red Phoenix Enters Grave \u6731\u96c0\u5165\u5893. It denotes possible lawsuits and complaints. Various twisting of facts and mismanagement of information can be expected as well. Avoid further disasters as a result of speaking without thinking."},wu:{rating:0,name:'bright hall receives treasure',nick:'treasure enters great square',note:'Support hidden within. Indicates allies and helpers are nearby. Advised to approach for support carefully and at the right moment.',desc:"This formation denotes offerings from others and that help is on the way. There will be support but you need to wait for the right time to ask. If it is located at an auspicious Door, everything will proceed well; at an inauspicious Door, however, all efforts are wasted."},ji:{rating:-1,name:'earth door meets ghost',nick:'ghost fades through door',note:'Cemented earth. Stagnation through the situation. Associated with unhappy outcomes, diseases, and decay.',desc:"This is a Fu Yin \u4f0f\u541f formation. There will be stagnation and obstruction along the way. The outcome will be unfavorable and people battling with sickness might succumb to the disease. This is because Ji \u5df1 is the cemetery."},geng:{rating:-1,name:'bright hall hidden',nick:'great square cannot be seen',note:'Iron from below. Brings conflict and disagreements. Resources will be targeted. Reputation will be at stake. Haste is not recommended.',desc:"This formation indicates upcoming legal disputes and arguments. Wealth may be lost and your privacy might be intruded. Be careful of being framed. Best to keep a low profile and stay passive. Do not initiate the lawsuit."},xin:{rating:-1,name:'spirit enters grave',nick:'grave greets the spirit',note:'Surface does not match that which is below. Appearance seems positive.  Reality is less so.',desc:"The formation denotes that things are well on the surface, but going nowhere. It indicates being flashy with no substance. Because of greed, you may lose the big picture."},ren:{rating:-1,name:'earthly net high stretch',nick:'earth net flutters',note:'Murky waters drown the plans. Associated with alternate motives, dishonesty, and lack of fidelity.',desc:"This is an unfavorable formation. It denotes scheming, betrayal, adultery, scandals and treachery."},gui:{rating:-1,name:'earthly punishment black tortoise',nick:'earth penalizes black turtle',note:'Dirty water penalty. Associated with disease, setbacks, and traps.',desc:"This is an unfavorable formation. Your plans will not succeed. Possible illness may arise. If meet with inauspicious doors, it denotes health hazard and prison term."}},geng:{jia:{rating:-1,name:'great yi hidden palace',nick:'wonder hidden from sight',note:'Iron covers Tree. Indicates darkness arising out of light. A turn from positive to negative. Associated with loss.',desc:"This is a highly inauspicious configuration. Denotes a switch from good to bad in a situation, loss of wealth and separation of loved ones."},yi:{rating:0,name:'great white meets star',nick:'star descends on white light',note:'Flower and Iron Combine. Neutral formation. Comes with bliss and sadness. Advised to be humble and take a passive stance.',desc:"Better to stay passive instead of active. Take note as extreme joy begets sorrow; it is better to conceal your victory to avoid stirring jealousy."},bing:{rating:-1,name:'great white enters shimmer',nick:'white light radiates',note:'Metal conflicts fire. Associated with loss, reputation damage, operational obstruction. Emotional distress, anxiety, and uncertainty. Advised to take action rather than stay passive.  This formation favors guest.',desc:"Denotes loss of wealth, possibility of being framed or harmed, and orders not carried out efficiently. The situation tortures the mind, body and soul. It favours the guest, not the host. Hence it\u2019s best to be proactive than reactive."},ding:{rating:0,name:'white pavilion of deceit',nick:'cabin of mistrust',note:'Metal covers Wonder. Indicates dramatic shift in situation due to deceit. Associated with loss, damages, and breakup.',desc:"There are drastic changes in the circumstances. More will be loss than gained. If there is an auspicious door, there will be a window of opportunity to escape from the problem."},wu:{rating:-1,name:'sitting palace structure',nick:'crouching palace',note:'Iron from above stabalizes below. A negative formation indicating initial failure prior to success.',desc:"You need to fail before you can succeed. This situation denotes that matters will first need to worsen before you see signs of improvement."},ji:{rating:-1,name:'punishment structure',nick:'penalty structure',note:'Associated with disagreements, conflicts, legal problems. Advised to prepare for attacks and instability.',desc:"This formation denotes internal arguments, family dispute, debauchery, and lawsuit. Extremely undesirable."},geng:{rating:-1,name:'great white same palace',nick:'white light mirrors self',note:'Clash of Blades. A structure associated with conflict and battle.  Harmony shall disintegrate from within, among peers, allies, mentors, and friends.',desc:"Also known as the War Structure. It is one of the more inauspicious formations in Qi Men. Unexpected disaster and misfortune, conflict among siblings, friends, or peers will arise. All matters are not proceeding smoothly and if they are, they will be sabotaged soon."},xin:{rating:-1,name:'white tiger stem formation',nick:'white tiger',note:'Iron and Gold Clash. Associated with problems during travel and journeys.  Related to the opposite gender. Objectives will be pulled apart due to misalignment in goals.',desc:"It is inauspicious for traveling afar for work, as traffic accidents or dispute with the opposite sex will plague you. The two Metals denote disputes and battle. There will be struggle and fights. Brace yourself."},ren:{rating:-1,name:'small structure',nick:'small formation',note:'Leading Ocean meets Iron Structure. A clash of movement and obstruction. Associated with problems during travel, new projects, and fresh endeavors. Advised to stay on path.',desc:"Known as the Upper Structure, Ren \u58ec Water indicates flowing movement while Geng \u5e9a is the Deity of Obstruction. It is unfavorable to travel far for business or to accept projects that are away from your core competence. Do not be greedy. You might also feel tied down in the wrong path."},gui:{rating:-1,name:'big structure',nick:'big formation',note:'Rain meets Iron Structure. Associated with accidents during movement, conflicts and disputes regarding plans and future.  Generally a negative structure for marriages, children, and relationships.',desc:"This is known as the Big Structure \u5927\u683c. As Yin \u5bc5 is in opposition to Shen \u7533, and Geng \u5e9a is the path or road, this formation may indicate traffic accidents. It also denotes fights, lawsuits, arguments and disagreements. This is not a good sign, especially when found during childbirth."}},xin:{jia:{rating:-1,name:'dragon tiger fight',nick:'tiger clashes dragon',note:'Tiger from above charges down below. Unstable conditions awaiting to worsen. Associated with wasted efforts due to conflicts. Positive outcomes will fail to be recognized.',desc:"The situation is unstable. Change is bound to happen for the worst. All efforts are futile as there are disagreements and miscommunications. Talents will remain unrecognized."},yi:{rating:-1,name:'ferocious white tiger',nick:'vicious white tiger',note:'Tiger charges from above to destroy Yi Wonder. Associated with problems during movement and travel. Indicates conflicts, arguments, lack of allegiance, and lack of clarity. Advised to be avoided for relationship matters.',desc:"Xin \u8f9b Metal clashes and counters with Yi \u4e59 Wood. This formation is named the Ferocious White Tiger \u767d\u864e\u7316\u72c2. Denotes danger during long distance travel, arguments and disputes, loss of faith and courage and uncertainties in the path ahead. Usually not a good formation for marriage."},bing:{rating:1,name:'stem combine rebelling officer',nick:'rebelling officer unites stem',note:'Bing Wonder arrives to save the day. On appearance, the situation is worsened. In reality, the situation is controlled. Most optimal with Auspicious Door.',desc:"The situation may be bad, but it\u2019s under control. Whether its outcome is favorable or not depends on the presence or absence of an Auspicious Door."},ding:{rating:-1,name:'restricted white tiger',nick:'white tiger suppressed',note:'Ding Wonder suppresses Xin Metal. A neutral formation. Possible gains if in the presence of an Auspicious Door.',desc:"The Ding \u4e01 Fire controls the Xin \u8f9b Metal. This denotes a solution to the problem. Doing business will generate considerable profit and even if you are at wrong, you can get absolved from the guilt. With the absense of an auspicious door, everything will start off well but ends badly."},wu:{rating:-1,name:'trapped dragon receives punishment',nick:'captured dragon receives penalty',note:'Mountain traps the Dragon. Indicates rebellion, disloyalty, clash of authority, and betrayal. Emotional distress may arise.',desc:"As Xin \u8f9b Metal counters Jia \u7532 Wood, Zi \u5b50 and Wu \u5348 also silently clash with each other. This formation is named Trapped Dragon Receives Punishment \u56f0\u9f8d \u53d7\u5236. It denotes direct changes of authority and disobedience in your colleagues or down line. It also represents financial mismanagement and relational discord. Best to control your emotions and keep yourself level-headed to avoid disaster."},ji:{rating:-1,name:'enter prison self punishment',nick:'self penalty in prison',note:'Xin Metal rebels. Indicates betrayal of apprentice and master. The subordinate goes against the wills of the superior. Righteousness and justice not observed. Advised to be careful with surrounding allies.',desc:"As Xin \u8f9b is the sinner and Xu \u620c is the Grave of Wu Fire this formation is named Enter Prison Self Punishment \u5165\u7344\u81ea\u5211. It denotes servant turning against the master, and subordinate challenging the superior. Justice is not served from losing a lawsuit. Take note at work as betrayal, injustice abound."},geng:{rating:-1,name:'white tiger carrying blade',nick:'white tiger carries sword',note:'Great Iron carries Sharp Blade. A clash of styles, damages abound. Associated with harm, breakups, separation, and conflicts.',desc:"Bodily harm, bloodshed or in some cases, lots of heart breaks. Dispute about everything can occur. An unexpected wound or disease may plague you or the person you love."},xin:{rating:-1,name:'the grand heavens fu yin',nick:'heavenly garden fu yiin',note:'Xin Metal Fu Yin. Indicates self-destruction.  Overconfidence leading to failure. Inability to be honest and practical about the situation.',desc:"Self sabotaging at work. Be careful of over-committing and under-delivering. Fortunes will be lost and you will have to end up fixing hassles and mess as a result of your inability to control yourself."},ren:{rating:-1,name:'the grand heavens meet prison',nick:'grand garden in prison',note:'Grand ocean suppresses progress. Personal conflicts with others. Obstructions throughout the process.',desc:"An unfavorable formation which denotes drawbacks, ill feelings, health hazards and confusion. Too many obstacles plague the way forward. Best to re look your plans."},gui:{rating:-1,name:'heavenly prison elegant seal',nick:'heaven prison meets elegant seal',note:'Energies of sun and moon stagnate. Progress is bold and optimistic, but reality is setback and slow to improve.',desc:"As Xin \u8f9b is the Heavenly Prison \u5929\u7262 and Gui \u7678 is the Elegant Seal \u83ef\u84cb, this formation is named Heavenly Prison Elegant Seal \u5929\u7262\u83ef\u84cb. The Sun and Moon grow dim, trapped in the Heavenly Net by mistake. This shows that even though your intentions are pure and your dreams are big, there are forces beyond your control holding you back. Better not be unreasonable at this point. Moving forward is tough and you will be plagued by many obstacles."}},ren:{jia:{rating:-1,name:'green dragon enters prison',nick:'green dragon captured',note:'Tree trapped under water. Indicates troubles from inside and outside. Associated with gossip, false truths, lies, and entangelements. Advised to stay out of chaos.',desc:"This formation indicates challenges from both domestic and foreign threats. You may be dragged into gossips and be the subject of rumors. Avoid trouble and hassle by staying passive and not getting involved."},yi:{rating:0,name:'small snake day noble',nick:'day wonder finds snake',note:'Ocean water drowns Yi Wonder. Situation worsens with obstacles and flaws. Associated with a pressing force holding down progress, rumors, lies, and loss of faith.',desc:"This formation denotes drawbacks and obstructions. Nothing is going on smoothly and plans are flawed. Sometime is tying you down and holding you back. Denotes bickering and betrayal."},bing:{rating:-1,name:'water snake enters fire',nick:'water dragon burns in fire',note:'Ocean clashes Sun. Associated with conflicts and arguments. Progress will be hindered.',desc:"Ren \u58ec clashes with Bing \u4e19. This situation invites lawsuit and disagreements. Since Ren \u58ec represents a snake, it represents being trapped or tied down - much like imprisonment. Plans will not succeed as planned and may even turn bad. Opportunities are missed."},ding:{rating:0,name:'stem combine snake punishment',nick:'snake penalizes stem',note:'Flame meets grand Ocean. Neutral formation which indicates a mix of indecision and hesitation. Associated with lack of communication. Favors male.',desc:"There are a lot of confusions. Lack of clarity is the cause for the lack of progress in this case. Take time to communicate clearly and clear the air. The situation favors male more than female."},wu:{rating:1,name:'small snake dragon force',nick:'water snake meets power',note:'Mountain earth dams water. Associated with positive success, popularity, and fame. Unhindered progress.',desc:"The situation favors those who seek fame and reputation. There will be support for your work. Plans will be executed smoothly with little or no hiccup."},ji:{rating:-1,name:'fierce snake enters prison',nick:'vicious snake captured',note:'Ocean snake captured by Earth. Obstruction and blockages in the upcoming path. Goals should be diverted for safety and passivity.',desc:"This is a negative formation that implies many obstacles and obstruction ahead. Success is far-fetched. It also represents being framed or put in a situation to solve another person\u2019s problems."},geng:{rating:-1,name:'great white catch snake',nick:'white light finds the snake',note:'White Tiger Geng finds Ocean Snake. Negative formation.',desc:"There will be fairness in judgment. As long as you have done no wrong, you need not fear. There is no need to act hastily."},xin:{rating:-1,name:'flying snake awakens',nick:'flying snake in the morning',note:'Negative formation associated with lies.  A smokescreen covering the truth.',desc:"This structure is named Flying Snake Awakens \u87a3\u86c7 \u76f8\u7e8f as Xin \u8f9b Metal enters the Grave at Chen \u8fb0. Snake represents lingering problems and hassle. It implies treachery and deceit. Even at an auspicious House, things are not likely to turn out well. If you are looking out for an opportunity, be mindful as you might be deceived."},ren:{rating:-1,name:'snake enters earth net',nick:'earth net captures snake',note:'Grand ocean floods the scene . Associated with poor luck, unfavorable results. Advised to avoid relationships, marriages, treatments, and new ventures.',desc:"Luck is not on your side this time. Your wish will not be granted. Nothing goes well. Be careful of making marriage commitments at this time, delivering a baby or even treating illnesses. The outcome will be unfavorable."},gui:{rating:-1,name:'young maiden commits adultery',nick:'young lady violates law',note:'Ocean and Mist dims truth. Associated with greed and jealousy.',desc:"If it seems too good to be true, it probably is. Greed is the root of the problem. Stop the greed and you can slow down the process of pain."}},gui:{jia:{rating:1,name:'green dragon enters earth',nick:'green dragon glides down',note:'Water feeds the Tree. A positive formation where negativity turns into positivity. Associated with receiving help and support from allies and noble people; creativity.',desc:"This formation turns bad luck into good. It denotes a positive turnaround and that one will receive help from a Noble person. New ideas will also come freely to you."},yi:{rating:0,name:'elegant seal meets star',nick:'star meets elegant seal',note:'Water feeds Flower. Generally neutral to positive formation with uninterrupted progress. Efficient operations and movement in a desired direction.',desc:"Promotion is smooth and the desired outcome can be obtained. The strategy is implemented very effectively."},bing:{rating:0,name:'elegant seal rebelling officer',nick:'rebelling leader meets elegant seal',note:'Gui Water meets Bing Fire. A neutral formation indicating pleasant progress, although a bit slow. Positive outcomes will flourish, but patience and steadiness is required. Associated with seeking spiritual guidance.',desc:"Better stick to the present or tolerate with what you have at hand rather than going beyond the line and pursuing something that is out of your reach. Things will develop slowly and sluggishly. Patience is necessary. Not auspicious either for meeting or asking for favors from another. Except only if you are seeking refuge or wisdom from monk, priest or a spiritual person."},ding:{rating:-1,name:'demon snake',nick:'snake reveals evil',note:'Ding Wonder meets a Snake. Water clashes Fire. Indicates arguments, conflicts, and internal battles. Associated with relationship clashes and possible hazards.',desc:"As Gui \u7678 Water counters and clashes with Ding \u4e01 Fire, and Ding Fire burns and boils Gui Water, this formation is named Demon Snake. It denotes being entwined in heated disputes and disagreements. Also denotes health hazards and catastrophies. It spells disasters in partnerships and team work. This is not an auspicious formation."},wu:{rating:1,name:'heavenly yi combine',nick:'heavenly marriage',note:'Heavenly Mountain marries Rain. Positive formation suitable for marriages, relationships, and meeting others. A sign of harmony and joy.  Associated with noble help, support from allies, and happy gatherings.',desc:"Good for wealth and relationship matters. This formation promotes harmony and success. There will also be support from a Noble person. It also denotes good union."},ji:{rating:-1,name:'elegant seal earth door',nick:'earth gate meets talent',note:'Murky Waters. Communication flows are disrupted. Inter-personal relationships, marriages, gatherings, and meetings are advised to be pushed back.',desc:"Communication is obstructed. Not good for personal relationship matters. Best to be absolutely clear and thorough when giving instructions."},geng:{rating:-1,name:'great white enters net',nick:'white light trapped',note:'White Tiger Drained. Rebellious subordinates, allies, and teammembers will disrupt the plan. Associated with ego problems, volatility, chaos, and arguments.',desc:"Your strategy is flawed as people\u2019s egos get in the way. Opinionated, unyielding and rebellious. Where this formation lands on an inauspicious Door, one may resort to violent dispute."},xin:{rating:-1,name:'elegant seal receive grace',nick:'elegant seal sees hindrance',note:'Negative formation indicating downturn before upside. As situation progresses, matters will turn into positive light. One is advised to be careful with surrounding people, as they could be driven by deviated intentions.',desc:"There will be losses before your gain. You could be surrounded by malicious people with ill intent. But the outcome is still favorable as long as you can persevere. This formation is not auspicious for predicting illness."},ren:{rating:-1,name:'heaven web end prison',nick:'heaven web in prison',note:'Water and Water cover the situation. One of the most unfavorable formations. Similar to a Punishment. Associated with trouble and chaos even amidst proper action. Lack of faith, trust, loyalty, and relationship control.',desc:"A highly inauspicious formation, where almost nothing is favorable. In fact you may get into trouble just for trying to help others. Marriage may turn sour and relationships become bitter. You may feel stuck as you juggle the lack of trust, commitment and love in your life."},gui:{rating:-1,name:'heavenly net four spreads',nick:'heaven net outward spread',note:'Inauspicious formation indicating a downhill spiral. Associated with worsening conditions, complete disharmony in plans, and disintegration of strategy. Advised to delay all important matters until situation has passsed.',desc:"This formation is extremely inauspicious. Everything fails on its own. The circumstances are against your wishes. You may lose your way. If you want to predict illness, you\u2019re likely to be greeted with worsening situation. Same goes for relationship, as things will likely to be disintegrated further."}}};var d={green_dragon_returns:{rating:2,match:[{isHeavenLeadStem:!0,earthStem:'bing'},{heavenStem:'wu',earthStem:'bing'}],almanacDefault:!0,color:h.default.RED[800],abbr:'GDR',name:'green dragon returns',chinese:'\u9752\u9f8d\u8fd4\u9996',pinyin:'long fan',note:'One of the three most auspicious structures.  Bing fire comes to aid Jia to burn Geng metal.  Opportunities will rise from the shadows.  Wealth and Career will accelerate to meet your goals.  Positive outcomes in marriages, friendships, and familly all-around.  Audiences will be impressed at one\'s spectacular display.  Black becomes White; Bad becomes Good.'},flying_bird_fall_into_cave:{rating:2,match:[{heavenStem:'bing',isEarthLeadStem:!0},{heavenStem:'bing',earthStem:'wu'}],almanacDefault:!0,color:h.default.BLUE[800],abbr:'FBFIC',name:'flying bird falls into cavern',chinese:'\u98db\u9ce5\u8dcc\u7a74',pinyin:'die xue',note:'One of the three most auspicious formations, this structure depicts a child returning home after a long journey away.  All matters will resolve to a natural balance -- suitable for business negotiations, career advancement, marital affairs, promotions, and studies.  Success will fall on your lap; no need to lift a finger.  Mentors will come to your aid, those around you will be persuaded, and the spirit around you will be lifted.'},jade_maiden_watching_the_door:{rating:2,match:[{heavenStem:'ding',isLeadDoor:!0},{earthStem:'ding',isLeadDoor:!0}],almanacDefault:!0,color:h.default.GREEN[800],abbr:'JLWD',name:'jade lady waiting by door',chinese:'\u7389\u5973\u5b88\u9580',pinyin:'yu nu',note:'One of the three most auspicious formations, this formation is suitable for interpersonal relationships, emotional bonds, and establishing rapport.  Positive events with others will unfold and arguments will dissipate.  One will gain the support of seniors and authority in education and career pursuits.'},cloud_dun:{rating:1,match:[{heavenStem:'yi',earthStem:'xin',door:'rest'},{heavenStem:'yi',earthStem:'xin',door:'life'},{heavenStem:'yi',earthStem:'xin',door:'open'},{heavenStem:'yi',door:'rest',palace:'kun'},{heavenStem:'yi',door:'open',palace:'kun'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Cloud',name:'cloud dun',chinese:'\u96f2\u9041',note:'This auspicious formation depicts a boy looking to the sky in wonder, filling his future with hopes and dreams and bringing confidence to his inner self.  This formation suggests that success is on the horizon and will be achieved.'},dragon_dun:{rating:1,match:[{heavenStem:'yi',door:'rest',palace:'kan'},{heavenStem:'yi',door:'open',palace:'qian'},{heavenStem:'yi',door:'life',palace:'kan'},{heavenStem:'yi',door:'open',palace:'kan'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Dragon',name:'dragon dun',chinese:'\u9f8d\u9041',note:'This auspicious formation depicts a dragon gliding through the skies, free to roam the heavens.  This formation is ideal for starting new projects and changes related to home and family.  This formation is associated with water and spiritual enlightenment.  Those who are on a quest to understand themselves will find this formation beneficial.'},heavenly_dun:{rating:1,match:[{heavenStem:'bing',earthStem:'ding',door:'life'},{heavenStem:'bing',earthStem:'wu',door:'life'},{heavenStem:'bing',door:'open'}],almanacDefault:!0,color:h.default.ORANGE[800],chinese:'\u5929\u9041',pinyin:'tian dun',abbr:'Heaven',name:'heaven dun',note:'It was once said, "out of the nine, the heaven rises".  There are 9 Auspicious Dun formations, and the Heavenly Den is one of the most auspicious.  This formation depicts an image of a powerful deity reaching down towards man to stabalize his affairs.  The Heaven Dun will bring forth justice and fairness, resulting in forward progress. '},earthly_dun:{rating:1,match:[{heavenStem:'yi',earthStem:'ji',door:'open'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Earth',name:'earth dun',chinese:'\u5730\u9041',note:'The Earth Den is an auspicious image of solid, stable things.  Extremely auspicious for maintaining order and keeping the status quo, this formation will give energy to those who are on a step-by-step climb to reach their goals.  This formation supports internal growth in a manner that is predictable and welcomed.'},man_dun:{rating:1,match:[{heavenStem:'ding',door:'rest',spirit:'moon'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Man',name:'man dun',chinese:'\u4eba\u9041',note:'This auspicious formation paints a picture of a visionary giving orders in the center of the stage.  Extremely beneficial for those who need to rally support, raise morale, and recruit newcomers to the team.'},wind_dun:{rating:1,match:[{heavenStem:'yi',door:'rest',palace:'xun'},{heavenStem:'yi',door:'life',palace:'xun'},{heavenStem:'yi',door:'open',palace:'xun'},{heavenStem:'bing',door:'open',palace:'xun'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Wind',name:'wind dun',chinese:'\u98a8\u9041',note:'The wind carries all things, as it was said.  This auspicious formation depicts information and memes flowing through society at quick speed.  Marketing endeavors will likely succeed, and word of mouth will grow to support the idea.'},tiger_dun:{rating:1,match:[{heavenStem:'yi',earthStem:'xin',door:'rest',palace:'gen'},{heavenStem:'yi',door:'life',palace:'gen'},{heavenStem:'xin',door:'life',palace:'gen'},{heavenStem:'geng',door:'open',palace:'dui'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Tiger',pinyin:'hu dun',name:'tiger dun',chinese:'\u864e\u9041',note:'The tiger is one who attacks without hesitation.  This auspicious formation paints a picture of a courageous leader attempting any and all strategies to achieve his goal, eventually arriving at success.  This formation will bring one persistence and determination to aggressively remove any obstacle standing in the way.'},deity_dun:{rating:1,match:[{heavenStem:'bing',door:'life',spirit:'heaven'},{heavenStem:'yi',door:'rest',spirit:'heaven'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Deity',name:'spirit dun',chinese:'\u795e\u9041',note:'The Spirit Den is arguably the most powerful of the Dens, as it is able to connect the individual to the fifth level of the heavenly sphere.  In Qi Men Dun Jia, the spirit dimension is responsible for the highest uncontrollable forces, and this formation allows one to form a direct connection to this level.'},ghost_dun:{rating:1,match:[{heavenStem:'yi',door:'delusion',spirit:'earth'},{heavenStem:'yi',door:'open',spirit:'earth'},{heavenStem:'yi',door:'life',spirit:'earth'},{heavenStem:'ding',door:'open',spirit:'earth'},{heavenStem:'ding',door:'rest',spirit:'earth'},{heavenStem:'ding',door:'life',spirit:'earth',palace:'gen'}],almanacDefault:!0,color:h.default.ORANGE[800],abbr:'Ghost',name:'ghost dun',chinese:'\u9b3c\u9041',note:'The Ghost Den is an auspicious formation that gives he who wields it the power of the shadows.  One will achieve the mission while hiding in plain sight.  Enemies will cease to notice; eyes will wander away.  Beneficial for those who wish to surprise the enemy.'},yi_noble_receives_envoy:{rating:1,match:[{heavenStem:'yi',palace:'qian'},{heavenStem:'yi',palace:'li'}],almanacDefault:!0,pinyin:'ri shi',name:'yi wonder meets envoy',abbr:'Yi Envoy',chinese:'\u65e5\u5947\u5f97\u4f7f',note:'In this formation, the pieces of the game are in the right position.  Team members are focused on their duties, goals are aligned, and motivation is present in all persons.  This is a positive indicator for all wealth, health, and relationship matters.'},bing_noble_receives_envoy:{rating:1,match:[{heavenStem:'bing',palace:'kan'},{heavenStem:'bing',palace:'kun'}],almanacDefault:!0,chinese:'\u6708\u5947\u5f97\u4f7f',pinyin:'yue shi',abbr:'Bing Envoy',name:'bing wonder meets envoy',note:'As one of the Three Wonders, Bing lights the way for Jia\'s path.  This formation depicts the noble receiving new opportunities for growth.  Plans will fork into rivers and streams as information will come to the noble at the right moment in time.  Actions taken will seem to fall in place, and decisions will seem solidified.  Suitable for all matters -- including relationships, careers, and business.'},ding_noble_receives_envoy:{rating:1,match:[{heavenStem:'ding',palace:'xun'},{heavenStem:'ding',palace:'gen'}],almanacDefault:!0,chinese:'\u661f\u5947\u5f97\u4f7f',pinyin:'xing shi',abbr:'Ding Envoy',name:'ding wonder meets envoy',note:'Ding enters the palace of Xun or Geng, receiving the necessary support for Jia.  This auspicious formation suggests positive development at every step.  As long as one is grounded and careful, education, career, and marital pursuits should be well secured.  This is an execellent formation for developing a skill or talent.'},yi_noble_rising_palace:{rating:1,match:[{heavenStem:'yi',palace:'zhen'}],almanacDefault:!0,chinese:'\u65e5\u5947\u6607\u6bbf',pinyin:'ri sheng',abbr:'Yi Palace',name:'yi wonder rises palace',note:'This auspicious formation is suitable for obtaining information.  Particularly well-suited for negotiation and research matters where specialized knowledge is hard to gain.  The Yi Wonder will assist in revealing such information to the surface.'},bing_noble_rising_palace:{rating:1,match:[{heavenStem:'bing',palace:'li'}],almanacDefault:!0,pinyin:'yue sheng',chinese:'\u6708\u5947\u6607\u6bbf',abbr:'Bing Palace',name:'bing wonder rises palace',note:'This positive formation depicts a sun shining into darkness, destroying evils and revealing virtue.  Traditionally used by law enforcement to fight crime, this formation is helpful when one\'s intention can be seen in the light, in which case, progress will likely ascend without hindrance.'},ding_noble_rising_palace:{rating:1,match:[{heavenStem:'ding',palace:'dui'}],almanacDefault:!0,pinyin:'xing sheng',abbr:'Ding Palace',name:'ding wonder rises palace',chinese:'\u661f\u5947\u6607\u6bbf',note:'This auspicious formation brings justice to the forefront of the situation.  No conspiracies or hidden agendas can escape the flame of Ding.  Relationships, battles, and business are all favored when Ding reaches the West, as this is the case.'},real_deception:{rating:1,match:[{heavenStem:'yi',door:'rest',spirit:'moon'},{heavenStem:'yi',door:'life',spirit:'moon'},{heavenStem:'yi',door:'open',spirit:'moon'},{heavenStem:'bing',door:'rest',spirit:'moon'},{heavenStem:'bing',door:'life',spirit:'moon'},{heavenStem:'bing',door:'open',spirit:'moon'},{heavenStem:'ding',door:'rest',spirit:'moon'},{heavenStem:'ding',door:'life',spirit:'moon'},{heavenStem:'ding',door:'open',spirit:'moon'}],name:'real deceit',pinyin:'zhen zha',chinese:'\u771f\u8a50',note:'Suitable for meditation, praying, healing, and growth.  The Great Moon is the spirit of the night and guards over the Yin nature of rejuvenation, consciousness, and awareness.'},double_deception:{rating:1,match:[{heavenStem:'yi',door:'rest',spirit:'earth'},{heavenStem:'yi',door:'life',spirit:'earth'},{heavenStem:'yi',door:'open',spirit:'earth'},{heavenStem:'bing',door:'rest',spirit:'earth'},{heavenStem:'bing',door:'life',spirit:'earth'},{heavenStem:'bing',door:'open',spirit:'earth'},{heavenStem:'ding',door:'rest',spirit:'earth'},{heavenStem:'ding',door:'life',spirit:'earth'},{heavenStem:'ding',door:'open',spirit:'earth'}],pinyin:'chong zha',name:'double deceit',chinese:'\u91cd\u8a50',note:'Double Deceit is an extremely advantageous formation to enhance the capable appearance of the individual.  Competitors and enemies will find it difficult to gauge your status, and you will appear with much more potential than reality holds.  This formation is also suitable for families, relationships, self improvement, and defense.'},nobility_deception:{rating:1,match:[{heavenStem:'yi',door:'rest',spirit:'harmony'},{heavenStem:'yi',door:'life',spirit:'harmony'},{heavenStem:'yi',door:'open',spirit:'harmony'},{heavenStem:'bing',door:'rest',spirit:'harmony'},{heavenStem:'bing',door:'life',spirit:'harmony'},{heavenStem:'bing',door:'open',spirit:'harmony'},{heavenStem:'ding',door:'rest',spirit:'harmony'},{heavenStem:'ding',door:'life',spirit:'harmony'},{heavenStem:'ding',door:'open',spirit:'harmony'}],chinese:'\u4f11\u8a50',pinyin:'xiu zha',name:'noble deceit',note:'This structure is formed when Harmony meets a Three Wonder at an auspicious Door.  The deity of Harmony governs personal affairs and relationships.  This formation will enhance the signal of trust, surrounding one with an aura of influence and fame.  Enemies may mistaken you as one who is not a threat, perhaps leading them to a hasty, wrong action.  This formation is suitable for those seeking help, rejuvenation, or enlightenment.'},heavenly_fake:{rating:1,match:[{heavenStem:'yi',door:'scenery',spirit:'heaven'},{heavenStem:'bing',door:'scenery',spirit:'heaven'},{heavenStem:'ding',door:'scenery',spirit:'heaven'}],name:'heaven conceal',chinese:'\u5929\u5047',note:'The Heaven Spirit is responsible for vision, intuition, and the future.  The heaven conceal formation brings the element of bad luck to within one\'s control.  This formation is most useful for gaining alliances, influencing those in power, and making plans to progress in academics or career.  Gaining traction in numbers is the focus of the structure.'},earthly_fake:{rating:1,match:[{heavenStem:'ding',door:'delusion',spirit:'harmony'},{heavenStem:'ding',door:'delusion',spirit:'moon'},{heavenStem:'ding',door:'delusion',spirit:'earth'},{heavenStem:'ji',door:'delusion',spirit:'harmony'},{heavenStem:'ji',door:'delusion',spirit:'moon'},{heavenStem:'ji',door:'delusion',spirit:'earth'},{heavenStem:'gui',door:'delusion',spirit:'harmony'},{heavenStem:'gui',door:'delusion',spirit:'moon'},{heavenStem:'gui',door:'delusion',spirit:'earth'}],pinyin:'di jia',chinese:'\u5730\u5047',name:'earth conceal',note:'Man hides in Mountain in this auspicious formation of camouflage.  This cloak will make investigation and exploration positive.  One may be able to slip by obstacles at ease.  This formation is suitable for remaining undetected.'},man_fake:{rating:1,match:[{heavenStem:'ren',door:'fear',spirit:'heaven'}],name:'man fake',chinese:'\u4eba\u5047',note:'Originally used for arresting criminals and finding missing people, this formation brings justice to the forefront.  Travelling is well supported, as the heaven spirit will guide those who wish to avoid tragedies.'},deity_fake:{rating:1,match:[{heavenStem:'ding',door:'harm',spirit:'harmony'},{heavenStem:'ding',door:'harm',spirit:'moon'},{heavenStem:'ding',door:'harm',spirit:'earth'},{heavenStem:'ji',door:'harm',spirit:'harmony'},{heavenStem:'ji',door:'harm',spirit:'moon'},{heavenStem:'ji',door:'harm',spirit:'earth'},{heavenStem:'gui',door:'harm',spirit:'harmony'},{heavenStem:'gui',door:'harm',spirit:'moon'},{heavenStem:'gui',door:'harm',spirit:'earth'}],name:'deity fake',chinese:'\u795e\u5047',note:'The deity concel formation is suitable for meditation, traversing the inner consciousness, and finding oneself on the right path.  The divine will bring forth energy to those who are concentrated on self improvement.'},ghost_fake:{rating:1,match:[{heavenStem:'ding',door:'death',spirit:'harmony'},{heavenStem:'ding',door:'death',spirit:'moon'},{heavenStem:'ding',door:'death',spirit:'earth'},{heavenStem:'ji',door:'death',spirit:'harmony'},{heavenStem:'ji',door:'death',spirit:'moon'},{heavenStem:'ji',door:'death',spirit:'earth'},{heavenStem:'gui',door:'death',spirit:'harmony'},{heavenStem:'gui',door:'death',spirit:'moon'},{heavenStem:'gui',door:'death',spirit:'earth'}],pinyin:'gui jia',name:'ghost fake',chinese:'\u9b3c\u5047',note:'The Ghost Fake formation depicts stillness within darkness.  Those who activate this formation will discover a journey towards the inner mandala, recognizing the elements that defines the Self.  This auspicious formation is suitable for planning and staging before a grand attack.'},sun_prosperity:{rating:1,match:[{heavenStem:'yi',palace:'xun'},{heavenStem:'yi',palace:'kan'}],pinyin:'ri wang',name:'Sun Prospers',chinese:'\u65e5\u65fa',note:'The Yi Wonder glows in the palaces of Xun and Kan, suggesting fame and recognition.  Those who wish to expand their business will find that resources and alliance support will come to aid.  This formation indicates an opportunity to show their talents -- if one choose to take it.  Finance, investments, and trade are benefited, and fortune may come.'},moon_prosperity:{rating:1,match:[{heavenStem:'bing',palace:'xun'},{heavenStem:'bing',palace:'zhen'}],pinyin:'yue wang',name:'Moon Prospers',chinese:'\u6708\u65fa',note:'Bing fire is the right hand of Jia.  When in the right palace (Xun or Zhen), this auspicious formation suggests a sudden turn of luck as a helpful ally will appear to offer encouragement or a sudden windfall will lift one out of troubles.  One will then find the motivation necessary to climb upwards.'},star_prosperity:{rating:1,match:[{heavenStem:'ding',palace:'xun'},{heavenStem:'ding',palace:'li'}],pinyin:'xin wang',chinese:'\u661f\u65fa',name:'Star Prospers',note:'This auspicoius formation depicts the Ding noble wandering into a garden of dreams.  One may find that their goals will come closer to achievement.  Insights will spring into the mind, allowing one to utilize streams of creativity to further advance.  The horizon of aspirations stretches far and wide.'},super_assisting_structure:{rating:1,match:[{isHeavenLeadStem:!0,earthStem:'yi'},{isHeavenLeadStem:!0,earthStem:'bing'},{isHeavenLeadStem:!0,earthStem:'ding'}],chinese:'\u76f8\u4f50\u683c',pinyin:'xiang zuo',name:'super assisting',note:'This formation is suitable for forming relationships with others -- gaining new allies and friends, seeking knowledge from mentors, and reestablshing old ties.  One must be careful to stay focused on the subject at hand and not stray from the goal.  Mentors and helpers may give positive energy to support your endeavors.'},quan_yi:{rating:1,match:[{heavenStem:'yi',isEarthLeadStem:!0},{heavenStem:'bing',isEarthLeadStem:!0},{heavenStem:'ding',isEarthLeadStem:!0}],pinyin:'quan yi',name:'Huan Yi / Quan Yi',chinese:'\u6b61\u6021 \u6b0a\u6021',note:'This auspicious fomation depicts a legendary warrior training at dawn.  Suitable for matters that require intense effort to succeed, this formation is supreme in that a Three Wonder from the heavens meet with the Jia on Earth.  With persistence, success will not be unattainable.'},three_noble_spirit:{rating:1,match:[{heavenStem:'yi',door:'rest',spirit:'harmony'},{heavenStem:'yi',door:'rest',spirit:'moon'},{heavenStem:'yi',door:'rest',spirit:'earth'},{heavenStem:'yi',door:'life',spirit:'harmony'},{heavenStem:'yi',door:'life',spirit:'moon'},{heavenStem:'yi',door:'life',spirit:'earth'},{heavenStem:'yi',door:'open',spirit:'harmony'},{heavenStem:'yi',door:'open',spirit:'moon'},{heavenStem:'yi',door:'open',spirit:'earth'},{heavenStem:'bing',door:'rest',spirit:'harmony'},{heavenStem:'bing',door:'rest',spirit:'moon'},{heavenStem:'bing',door:'rest',spirit:'earth'},{heavenStem:'bing',door:'life',spirit:'harmony'},{heavenStem:'bing',door:'life',spirit:'moon'},{heavenStem:'bing',door:'life',spirit:'earth'},{heavenStem:'bing',door:'open',spirit:'harmony'},{heavenStem:'bing',door:'open',spirit:'moon'},{heavenStem:'bing',door:'open',spirit:'earth'},{heavenStem:'ding',door:'rest',spirit:'harmony'},{heavenStem:'ding',door:'rest',spirit:'moon'},{heavenStem:'ding',door:'rest',spirit:'earth'},{heavenStem:'ding',door:'life',spirit:'harmony'},{heavenStem:'ding',door:'life',spirit:'moon'},{heavenStem:'ding',door:'life',spirit:'earth'},{heavenStem:'ding',door:'open',spirit:'harmony'},{heavenStem:'ding',door:'open',spirit:'moon'},{heavenStem:'ding',door:'open',spirit:'earth'}],chinese:'\u4e09\u5947\u4e4b\u9748',pinyin:'San Qi Zhi',name:"three wonder spirit",note:'This auspicious formation will help one develop a clear path as one strives forward.  Strengths and weaknesses will be revealed.  This formation does not automatically guarantee success, but will come to great aid if preparation and planning is in order.'},ferocious_white_tiger:{rating:-1,match:[{heavenStem:'xin',earthStem:'yi'}],pinyin:'hu chang',name:'vicious white tiger',chinese:'\u767d\u864e\u7316\u72c2',note:'Xin is the knife that cuts Yi Wood.  The vicious white tiger indicates that a storm is ahead.  One should be careful with every step and avoid drastic decisions.  If one is uncertain, calm meditative practices may be wise to secure a decision.  Relationships, marriages, new constructions, and new business plans should be carefully considered.'},tangling_snake:{rating:-1,match:[{heavenStem:'gui',earthStem:'ding'}],pinyin:'she jiao',name:'entangled snake',chinese:'\u52dd\u86c7\u5996\u5b0c',note:'Gui water rains on flame.  An entangled snake is one which cannot smoothly proceed without conflict.  One will find that in order to reach a conclusion, small and minor issues must be resolved before giant steps can be taken.'},green_dragon_escape:{rating:-1,match:[{heavenStem:'yi',earthStem:'xin'}],name:'green dragon runs away',chinese:'\u9752\u9f8d\u9003\u8d70',note:'The Green Dragon indicates prosperity and fortune, but this formation indicates that the confident energy is absent.  One should think twice before making dramatic changes.  It is advised to take the calm road at this moment.'},red_phoenix_diving_water:{rating:-1,match:[{heavenStem:'ding',earthStem:'gui'}],name:'sparrow dives into river',chinese:'\u6731\u96c0\u6295\u6c5f',note:'Arguments and conflicts may escalate into serious battles.  When the Ding wonder enters water, the flame is lost.'},shimmering_enters_white:{rating:-1,match:[{heavenStem:'bing',earthStem:'geng'}],pinyin:'ying bai',name:'shimmering white',chinese:'\u7192\u60d1\u5165\u767d',note:'Also known as Mars Enters Venus.  Time will be the most valuable asset, as this structure suggests danger lurking ahead.  One should look for obstacles and traps before pushing forward into battle.  Wisdom suggests reconsidering one\'s options -- perhaps finding an alternate route to the destination.'},great_white_enters_darkness:{rating:-1,match:[{heavenStem:'geng',earthStem:'bing'}],name:'white enters dark',chinese:'\u592a\u767d\u5165\u7192',note:'Also known as Venus Enters Mars, this formation favors the guest and suppresses the host.  Geng metal is the enemy of Jia, and this special formation depicts a rising inauspicious light.  One should approach the matter proactively (as the guest) in order to secure the victory.'},punishment_structure:{rating:-1,match:[{heavenStem:'geng',earthStem:'ji'}],name:'punishment',chinese:'\u5211\u683c',note:'This inauspicious formation depicts a pattern of chaos spiralling out of control.  Geng meets with Ji to trap the Jia.  Not suitable for financial decisions, legal entanglements, negotiations, or disputes'},war_structure:{rating:-1,match:[{heavenStem:'geng',earthStem:'geng'}],pinyin:'zhan ge',name:'war configuration',chinese:'\u6230\u683c',note:'This inauspicious formation suggests tragic loss and disaster.  With both Geng metals as the stems, danger could lie ahead if one is not careful.'},noble_structure:{rating:-1,match:[{heavenStem:'geng',earthStem:'yi'},{heavenStem:'geng',earthStem:'bing'},{heavenStem:'geng',earthStem:'ding'}],chinese:'\u5947\u683c',pinyin:'qi ge',name:'three wonders setting',note:'Geng is the mortal enemy of Jia.  In this inauspicious combination, Geng metal combines with one of the Three Wonders -- Yi, Bing, and Ding.  This formation is not suitable for matters related to conflict or competition.  One must be careful when dealing with money matters.  If Yi is combined, Guest is favored.  If Bing or Ding is combined, Host is favored.'},flying_stem_structure:{rating:-1,match:[{heavenStem:'$dayStem',earthStem:'geng'}],name:'flying stem',chinese:'\u98db\u5e72\u683c',note:'Obstacles reveal themselves every day, but this one will affect one\'s relationship in the professional world.  This inauspicious formation creates problems for the individual.'},big_structure:{rating:-1,match:[{heavenStem:'geng',earthStem:'gui'}],name:'big configuration',chinese:'\u5927\u683c',note:'This inauspicious formation illustrates that an important element of the solution is missing.  One cannot proceed without having a complete set of tools and support for the situation.'},small_structure:{rating:-1,match:[{heavenStem:'geng',earthStem:'ren'}],name:'small configuration',pinyin:'fu ge',chinese:'\u5c0f\u683c',note:'This inauspicious structure depicts a military strategist trapped in a continuous mental cycle with no new ideas to proceed.  This structure directly affects the ego and self esteem of an individual, limiting his ability to formulate.'},flying_palace_structure:{rating:-1,match:[{isHeavenLeadStem:!0,earthStem:'geng'},{heavenStem:'wu',earthStem:'geng'}],name:'flying palace',chinese:'\u5929\u4e59\u98db\u5bae\u683c',note:'This inauspicious formation harms both host and guest.  It depicts that although a general can control his troops, he cannot control the weather.  Forces outside of the general\'s control will throw curve his plans, which may need to be adapted to the new environment.'},sitting_palace_structure:{rating:-1,match:[{heavenStem:'geng',isEarthLeadStem:!0},{heavenStem:'geng',earthStem:'wu'}],chinese:'\u5929\u4e59\u4f0f\u5bae\u683c',pinyin:'fu gong',name:'sitting palace',note:'This formation indicates a loss of leadership vission.  Subordinates may lose faith; co-workers may distrust.  The mission will stagnate as obstacles will emerge to hinder progress.  The future is blurry, and one should tread carefully when making decisions.'},three_noble_enters_graves:{rating:-1,match:[{heavenStem:'yi',palace:'kun'},{heavenStem:'yi',palace:'qian'},{heavenStem:'bing',palace:'qian'},{heavenStem:'bing',palace:'kan'},{heavenStem:'ding',palace:'gen'},{heavenStem:'ding',palace:'kan'}],comment:'Some masters use Earth Stem',chinese:'\u6708\u5947\u5165\u57fa',pinyin:'yue mu',name:'three wonders in tomb',note:'The Three Wonders (Yi, Bing, Ding) is the cornerstone of Qi Men Dun Jia.  In this formation, a Wonder is in tomb (palace).  Efforts will slowly progress.  Positive matters will turn negative.  Support will dwindle and relationships may be impacted.  Critical decisions are better off delayed as the storm passes.  At this point, hesitation may be a wise choice.'},three_noble_restricting_or_controlling:{rating:-1,match:[{heavenStem:'bing',palace:'kan'},{heavenStem:'ding',palace:'kan'},{heavenStem:'yi',palace:'qian'},{heavenStem:'yi',palace:'dui'}],pinyin:'ri zhi',chinese:'\u4e09\u5947\u53d7\u5236',name:'three wonders suppressed',note:'This neutral formation indicates one of the Three Wonders landing in a palace that supresses its strength.  As the job of a Wonder is to protect the Jia, this formation suggests that the Wonder is unable to perform its duty to the fullest extent.  However, hope is not lost.'},six_crest_striking_punishment:{rating:-1,match:[{heavenStem:'wu',palace:'zhen'},{heavenStem:'ji',palace:'kun'},{heavenStem:'geng',palace:'gen'},{heavenStem:'xin',palace:'li'},{heavenStem:'ren',palace:'xun'},{heavenStem:'gui',palace:'xun'}],name:'six crest strike penalty',chinese:'\u516d\u5100\u64ca\u5211',note:'The Six Crest Penalty is an inauspicious formation that denotes an individual being pressed against a wall from all sides, leaving no room for escape.  This causes an emotional disaster, as the individual is forced to make a choice with no positive outcome.'}};o.structures=d;o.formStructureForLibrary=function(){var e={};return Object.keys(d).forEach(function(i){var n,t,a=d[i];a.rating>0?(n='Auspicious',t='\u272d'):a.rating<0&&(n='Inauspicious',t='\u2a02');var o={name:a.name,chinese:a.chinese,description:a.note,auspicious:n},s=t+'  '+a.name+' '+a.chinese;e[s]=o}),e};o.hours={jia:{rest:{rating:2},life:{rating:2},harm:{rating:0},delusion:{rating:-1},scenery:{rating:1},death:{rating:-2},fear:{rating:-1},open:{rating:0}},yi:{rest:{rating:1},life:{rating:1},harm:{rating:-1},delusion:{rating:-1},scenery:{rating:0},death:{rating:-2},fear:{rating:-2},open:{rating:2}},bing:{rest:{rating:0},life:{rating:2},harm:{rating:-2},delusion:{rating:-2},scenery:{rating:0},death:{rating:-2},fear:{rating:-1},open:{rating:1}},ding:{rest:{rating:2},life:{rating:1},harm:{rating:-1},delusion:{rating:-1},scenery:{rating:1},death:{rating:-2},fear:{rating:0},open:{rating:1}},wu:{rest:{rating:1},life:{rating:1},harm:{rating:-1},delusion:{rating:-1},scenery:{rating:0},death:{rating:-1},fear:{rating:-2},open:{rating:1}},ji:{rest:{rating:1},life:{rating:0},harm:{rating:-1},delusion:{rating:-2},scenery:{rating:-1},death:{rating:-2},fear:{rating:-1},open:{rating:2}},geng:{rest:{rating:2},life:{rating:2},harm:{rating:-2},delusion:{rating:-1},scenery:{rating:1},death:{rating:-2},fear:{rating:-1},open:{rating:0}},xin:{rest:{rating:2},life:{rating:1},harm:{rating:-2},delusion:{rating:-1},scenery:{rating:0},death:{rating:-1},fear:{rating:0},open:{rating:0}},ren:{rest:{rating:0},life:{rating:2},harm:{rating:-2},delusion:{rating:-1},scenery:{rating:0},death:{rating:-1},fear:{rating:-1},open:{rating:1}},gui:{rest:{rating:-1},life:{rating:0},harm:{rating:-1},delusion:{rating:-1},scenery:{rating:1},death:{rating:-2},fear:{rating:-1},open:{rating:0}}};o.usefulGodSymbols={relationships:[['Yi Wood (Heaven Stem)','Female'],['Geng Metal (Heaven Stem)','Male'],['Harmony (Spirit)','Matchmaker (introducer)'],['Ding Fire (Heaven Stem)','Mistress (female)'],['Bing Fire (Heaven Stem)','Lover (male)'],['Year Stem','Outcome']],childbirth:[['Kun Palace (SW)','Mother / Hospital Room'],['Kun Palace (SW) Star','Child'],['Kun Palace (SW) Door','Baby (male if Yang Door, female if Yin Door)'],['Kun Palace (SW) Heaven Stem','Baby (male if Yang Stem, female if Yin Stem)']],health:[['Day Stem','Patient (adult)'],['Hour Stem','Patient (child)'],['Grain (Star)','Illness / disease'],['Grain (Star) Palace','Time of critical stage of illness / category of illness'],['Life (Door)','Life context of patient'],['Death (Door)','Death context of patient'],['Heart (Star)','Doctor'],['Yi Wood (Heaven Stem)','Doctor'],['Destructor (Star)','Hospital'],['Grain in Kan','Reproductive system / kidney / bladder / urinary tract / lower abdomen'],['Grain in Kun','Stomach / spleen / intestines / right upper limb'],['Grain in Zhen','Liver / gallbladder / left abdomen / hips'],['Grain in Xun','Shoulder / neck / left arm'],['Grain in Qian','Head / large intestine / back / joints / right leg'],['Grain in Dui','Lung / right abdomen / throat / esophagus / mouth / skin'],['Grain in Gen','Left lower limb'],['Grain in Li','Heart, veins, arteries, head, brain']],body:[['Jia Wood (Heaven Stem)','Liver / gallbladder'],['Yi Wood (Heaven Stem)','Liver / gallbladder / esophagus / throat'],['Bing Fire (Heaven Stem)','Small intestines / mouth / forehead'],['Ding Fire (Heaven Stem)','Heart / eyes / teeth'],['Wu Earth (Heaven Stem)','Abdomen / stomach / nose'],['Ji Earth (Heaven Stem)','Face'],['Geng Metal (Heaven Stem)','Rib / large intestine'],['Yin Metal (Heaven Stem)','Lung / bones'],['Ren Water (Heaven Stem)','Pulse / blood / urine / bladder / hair'],['Gui Water (Heaven Stem)','Kidney / veins / foot / limbs / genitals']],legal:[['Hour Stem','Self'],['Day Stem','Officer'],['Year Stem','Outcome'],['Lead Door','Processor'],['Yi Wood (Heaven Stem)','Defendent'],['Ding Fire (Heaven Stem)','Evidence'],['Ren Water (Heaven Stem)','Lawsuit / Conflict'],['Geng Metal (Heaven Stem)','Verdict'],['Scenery (Door)','Testimony / documents'],['Fear (Door)','Lawyers'],['Open (Door)','Judge / Arbitrator'],['Chief (Spirit)','Plaintiff'],['Snake (Spirit)','Lawsuit / Conflict'],['Harmony (Spirit)','Witness / Evidence']],crime:[['Jia Wood (Heaven Stem)','Criminal'],['Xin Metal (Heaven Stem)','Convict / Prisoner'],['Ren Water (Heaven Stem)','Prison'],['Gui Water (Heaven Stem)','Prison'],['Grass (Star)','Criminal'],['Tortoise (Spirit)','Thief'],['Harmony (Spirit)','Fugitive / on the run'],['Harm (Door)','Law Enforcement / Arrestor'],['Open (Door)','Judge']],mentors:[['Grain (Star)','Student'],['Assistant (Star)','Mentor'],['Chief (Spirit)','Mentor'],['Open (Door)','Current Leader'],['Delusion (Door)','Philosophy / esoteric knowledge'],['Scenery (Door)','Special talents, abilities, or understanding of the topic. (also desire to be recognized)'],['Earth (Spirit)','Conservative approach / guarded information.'],['Tiger (Spirit)','Blockages in studies and progression'],['Wu Earth (Heaven Stem)','Retiring Leader'],['Day Stem','Self']],meetings:[['Rest (Door)','Appointment / meeting'],['Day Stem','Self / Asker / Person attending meeting'],['Hour Stem','Other party'],['Heaven Stems (all)','Guest'],['Earth Stems (all)','Host']],lost:[['Day Stem','Owner'],['Hour Stem','Missing item'],['Interior Plate','Item is nearby'],['Exterior Plate','Item is far away'],['Fan Yin','High chance of recovery'],['Fu Yin','Low chance of recovery'],['Tortoise (Spirit)','Thief (if located with hour stem)']],information:[['Scenery (Door)','Focus for news and information received.'],['Phoenix (Spirit)','Focus for truthfulness of information']],luck:[['Sitting / Travel Direction','Focus point'],['Year Stem of Individual','Focus point of individual.'],['Performing a Reading','Analyze the palaces of each focus point, their properties, and the relationship of the palaces to each other.']],general:[['Year Stem','Superiors / Parents'],['Month Stem','Colleagues / Siblings'],['Day Stem','Self'],['Hour Stem','Focus point for general matters / Subordinates / Children'],['Stars','Time and circumstance'],['Doors','People matters'],['Spirits','Natural forces beyond control'],['Palaces','Circumstance'],['Performing a Reading','Analyze palaces of each focus point, their properties, and the relationship of the palaces with each other. Include analysis with Death-Emptiness (reduction/stagnation/stoppage) and Travelling Horse (movement/speed/change).']],finance:[['Month Stem','Competitor'],['Day Stem','Individual requesting the forecast'],['Hour Stem','Goods / Money / Products / Service'],['Wu Earth (Heaven Stem)','Capital'],['Scenery (Door)','Market Condition'],['Open (Door)','Vendor / shop'],['Death (Door)','Land'],['Life (Door)','Returns or Profits'],['Star of Life (Door)','Wealth'],['Palace of Life (Door)','Amount of Wealth'],['Palace of Open, Rest, Life (Doors)','Directions one can find rewards'],['Lead Door','Borrower or Buyer'],['Harmony (Spirit)','Agent, Middleman'],['Chief (Spirit)','Bank, Supporter, Creditor'],['Yi Wood (Earth Stem)','Borrower'],['Earthly Branch of Palace of Hour Stem (Earth Plate)','Time when one receives reward.']],sales:[['Chief (Spirit)','Seller'],['Lead Door','Buyer'],['Hour Stem','Goods / Products'],['Wu Earth','Capital / Assets'],['Life (Door)','Returns / Profits'],['Scenery (Door)','Process / image'],['Harmony (Spirit)','Middleman / salesman / partnership']],deals:[['Day Stem','Buyer / asker'],['Hour Stem','Seller / competition / enemy'],['Month Stem','Others in the industry'],['Harmony (Spirit)','Middleman / Agent']],partnerships:[['Day Stem','Self'],['Hour Stem','Partner / Potential Partner'],['Life (Door','Returns / Profits from the partnership'],['Open (Door)','Commencement / Beginnings'],['Analysis','Auspicious for asker if palace of hour stem produces palace of day stem. Auspicious for other party if vice-versa. If both elements of palaces are equal, the partnership will be equal and fair.']],industries:[['Jia + Yi Wood','Medicine / design / food / education / gardening / furniture / clothing / books / nature'],['Bing + Ding Fire','Beauty / computers / cooking / electronics / energy / cinema / photograpy / restaurant / food'],['Wu + Ji Earth','Real estate / architecture / antiques / materials / landscaping / mining'],['Geng + Xin Metal','Appliances / machinery / jewelry / transportation / electronics / finance'],['Ren + Gui Water','Advertising / entertainment / health / media / psychology / public relations / travel / transportation']],parking:[['Death/Emtpinesss','Direction where space is available.']],property:[['Day Stem','Occupants of the house (or Buyer or Seller, depending in situation)'],['Chief (Spirit)','Buyer 