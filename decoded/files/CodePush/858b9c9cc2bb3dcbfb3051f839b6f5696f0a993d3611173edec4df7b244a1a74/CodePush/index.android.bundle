me:'retreat',chinese:'',icon:'ember',isDefaultSelected:!0,rating:0,desc:'Prone to setbacks, career hindrance. Slow to progress. Requires more work than average.'},solitaryPhoenix:{$dict_noun:['solitude','depth','transformation'],ref:'specialDayMasterAux',name:'solitaryPhoenix',chinese:'',icon:'language-swift',isDefaultSelected:!0,rating:0,desc:'Difficulty with relationships, due to Companion star found in Day Branch.'}},specialPillarAux:{redLight:{$dict_noun:['relationships','volatility'],ref:'specialPillarAux',name:'redLight',chinese:'',icon:'flare',isDefaultSelected:!0,rating:0,desc:'One with red light pillars often have problems with stable relationships.  The effect is greatest if this pillar is found in the Day.'},yinYangMismatch:{$dict_noun:['relationships','mismatch'],ref:'specialPillarAux',name:'yinYangMismatch',chinese:'',icon:'yin-yang',isDefaultSelected:!1,rating:0,desc:'The effects are stronger if this pillar is found in the Day. In the old days, a chart with more than one such pillar tend towards arranged marriages.'},commander:{$dict_noun:['leadership','success','ambition'],ref:'specialPillarAux',name:'commander',chinese:'',icon:'chess-king',isDefaultSelected:!0,rating:1,desc:'One who posesses this pillar has the ability to achieve enormous success due to their ambitious nature.  These people possess high degrees of drive and forward-looking motivations.  The effect is greatest if this pillar is found in the Day.'}},dayStemAux:{nobleman:{$dict_noun:['helper','savior','mentor'],ref:'dayStemAux',name:'nobleman',chinese:'\u5929\u4e59\u8cb4\u4eba',icon:'face',isDefaultSelected:!0,rating:1,desc:'Helpful person in your life \u2013 one who will lift you out of troubles. The most auspicious star, especially if found in natal chart.'},saltPool:{$dict_noun:['lust','passion','romance'],ref:'dayStemAux',name:'saltPool',chinese:'\u54b8\u6c60',icon:'pool',isDefaultSelected:!0,rating:0,desc:'Lust, attraction, charisma.  Internal romance if found in year/month.  External romance if found in day/hour.'},intelligence:{$dict_noun:['intuition','problem solving','abstraction'],ref:'dayStemAux',name:'intelligence',chinese:'\u6587\u660c',icon:'school',isDefaultSelected:!0,rating:1,desc:'Intuition, pattern recognition, fast learning. Also known as Intelligence Star.'},thriving:{$dict_noun:['drive','willpower','determination','successs'],ref:'dayStemAux',name:'thriving',chinese:'\u797f\u795e',icon:'hexagram',isDefaultSelected:!0,rating:1,desc:'Filled with energy, encouraged to succeed.  If Weak DM: success comes easily.  If Strong DM: easy to be lazy.'},goatBlade:{$dict_noun:['motivation','courage','volatility','aggression','injury'],ref:'dayStemAux',name:'goatBlade',chinese:'\u7f8a\u5203',icon:'knife',isDefaultSelected:!0,rating:1,desc:'Bravery and courage. Intense with strong motivations. This is a Companion star; therefore, brings confidence to ego. Works well with 7Killings to achieve greatness. Prone to injuries due to aggressive nature.'},redChamber:{$dict_noun:['romance','lust','infidelity'],ref:'dayStemAux',name:'redChamber',chinese:'\u7ea2\u8273',icon:'heart-multiple',isDefaultSelected:!0,rating:0,desc:'Passion, lust, infidelity, affairs, romance. [Most relevant if in Day Branch]'},studyRoom:{$dict_noun:['learning','persistence','knowledge'],ref:'dayStemAux',name:'studyRoom',chinese:'\u5b78\u5802',icon:'book-open',isDefaultSelected:!0,rating:1,desc:'Knowledge, studies, learning, persistence. Also known as Literacy.'},cascadeClouds:{$dict_noun:['revenge','vengeance','bitterness'],ref:'dayStemAux',name:'cascadeClouds',chinese:'\u6d41\u971e',icon:'cloud-outline',isDefaultSelected:!0,rating:0,desc:'Revenge, disasters, trauama, or miscarriage.'},flyingSword:{$dict_noun:['movement','speed','surprise','consequences'],ref:'dayStemAux',name:'flyingSword',chinese:'\u98db\u5203',icon:'pinwheel',isDefaultSelected:!0,rating:0,desc:'Things move fast. Prone to surprising consequences.'},goldCarriage:{$dict_noun:['partner','wealth','relationships','meetings'],ref:'dayStemAux',name:'goldCarriage',chinese:'\u91d1\u8f3f',icon:'caravan',isDefaultSelected:!0,rating:1,desc:'Easily meet a partner who brings wealth or support. Good, proper relationships with others. [Ideally a wealth star with Day Branch being Useful God]'},rightMeasure:{$dict_noun:['respect','guidelines','laws'],ref:'dayStemAux',name:'rightMeasure',chinese:'\u8282\u5ea6',icon:'scale-balance',isDefaultSelected:!0,rating:1,desc:'Respect for others.  Follows guidelines and laws.'},wealthStorage:{$dict_noun:['savings','wealth','frugality'],ref:'dayStemAux',name:'wealthStorage',chinese:'\u8d22\u5e93',icon:'briefcase',isDefaultSelected:!0,rating:1,desc:'Able to keep and save money.'},skyWealth:{$dict_noun:['lottery','windfall','rewards'],ref:'dayStemAux',name:'skyWealth',chinese:'\u5929\u8d22',icon:'cash',isDefaultSelected:!0,rating:1,desc:'Prosperity. Enhanced if found in Luck or Annual Pillar. Ideal if Strong DM.'}},dayBranchAux:{redMatchmaker:{$dict_noun:['romance','joy','harmony','fortune'],ref:'dayBranchAux',name:'redMatchmaker',chinese:'\u7d05\u9e1e',icon:'account-multiple',isDefaultSelected:!0,rating:1,desc:'Bright future, enhances positive aura. Positive surroundings and happy events.'},elegantSeal:{$dict_noun:['artist','talent','creativity','learning'],ref:'dayBranchAux',name:'elegantSeal',chinese:'\u534e\u76d6',icon:'brush',isDefaultSelected:!0,rating:1,desc:'Artistic talents, creative productions. Enhanced learning capabilities, especially if it is a Resource.'},general:{$dict_noun:['leadership','organization','success','influence'],ref:'dayBranchAux',name:'general',chinese:'\u5c07\u661f',icon:'chess-rook',isDefaultSelected:!0,rating:1,desc:'Capable of leading an organization to success. Can spread influence.'},skyHorse:{$dict_noun:['change','movement','travel','speed'],ref:'dayBranchAux',name:'skyHorse',chinese:'\u9a5b\u99ac',icon:'donkey',isDefaultSelected:!0,rating:1,desc:'Change, movement, or travel.'},peachBlossom:{$dict_noun:['charisma','appearance','aura','attraction'],ref:'dayBranchAux',name:'peachBlossom',chinese:'\u6843\u82b1',icon:'heart',isDefaultSelected:!0,rating:1,desc:'Charisma, appearance, aura.  Easily attract others.'},bloodBlade:{$dict_noun:['accidents','mishaps','carelessness'],ref:'dayBranchAux',name:'bloodBlade',chinese:'\u8840\u5203',icon:'needle',isDefaultSelected:!0,rating:0,desc:'Prone to accidents, mishaps, falls, cuts, surgeries.'},solitude:{$dict_noun:['self-reflection','alone','internal'],ref:'dayBranchAux',name:'solitude',chinese:'\u5b64\u8fb0',icon:'candle',isDefaultSelected:!0,rating:1,desc:'Preference to be alone. Can self-reflect. Good for pondering. Dislikes big groups of people.'},lonely:{$dict_noun:['awareness','spiritual','philosophy'],ref:'dayBranchAux',name:'lonely',chinese:'\u5be1\u5bbf',icon:'feather',isDefaultSelected:!0,rating:1,desc:'Philosophical, spiritual, can gain enlightenment. Prefers to be alone.'},funeralGate:{$dict_noun:['yin','energies','spirits','hospitals','funerals'],ref:'dayBranchAux',name:'funeralGate',chinese:'\u55aa\u9580',icon:'gate',isDefaultSelected:!0,rating:0,desc:'Prone to attracting energies from funerals, hospitals, and spirits.'},robbery:{$dict_noun:['impatience','intense','demand','take'],ref:'dayBranchAux',name:'robbery',chinese:'\u52ab\u715e',icon:'account-arrow-right',isDefaultSelected:!0,rating:0,desc:'Impatient, difficult to deal with. Attracts others who are intense and demanding. Possible betrayal by friends.'},separateEdge:{$dict_noun:['disputes','entanglements','separation','society'],ref:'dayBranchAux',name:'separateEdge',chinese:'\u9694\u89d2',icon:'scissors-cutting',isDefaultSelected:!0,rating:0,desc:'Disputes and entanglements. Possible separation from society.'},deathGod:{$dict_noun:['attention','details','power','shallow','spendthrift','collateral damage'],ref:'dayBranchAux',name:'deathGod',chinese:'\u4ea1\u795e',icon:'death-star',isDefaultSelected:!0,rating:0,desc:'Dedicated to work, attention to detail. If useful star: power and fame.  If not useful star: shallow, spendthrift. Possibly cause harm to others.'}},monthBranchAux:{heavenRelief:{$dict_noun:['protection','get-out-of-jail','relief'],ref:'monthBranchAux',name:'heavenRelief',chinese:'\u5929\u6055',icon:'beach',isDefaultSelected:!0,rating:1,desc:'Protection, even if one has done something wrong. "Get out of jail" card.'},heavenHappiness:{$dict_noun:['future','positivity','optimism','focused','joyful'],ref:'monthBranchAux',name:'heavenHappiness',chinese:'\u5929\u559c',icon:'emoticon-excited-outline',isDefaultSelected:!0,rating:1,desc:'Forward-looking, positive outlook on life. Will not involve in trivial or petty disagreements. Will live a joyful life.'},heavenVirtueNoble:{$dict_noun:['strong','fatherly','protection','earnest','focused'],ref:'monthBranchAux',name:'heavenVirtueNoble',chinese:'\u5929\u5fb7\u8d35\u4eba',icon:'face-profile',isDefaultSelected:!0,rating:1,desc:'Strong, fatherly figure of protection. One is earnest and focused.'},monthlyVirtueNoble:{$dict_noun:['soft','motherly','protection','generosity','compassion'],ref:'monthBranchAux',name:'monthlyVirtueNoble',chinese:'\u6708\u5fb7\u8d35\u4eba',icon:'face-profile',isDefaultSelected:!0,rating:1,desc:'Soft, motherly figure of protection. One is considerate and generous.'},monthEmptiness:{$dict_noun:['wandering','uncertainty','path'],ref:'monthBranchAux',name:'monthEmptiness',chinese:'\u6708\u7a7a',icon:'battery-outline',isDefaultSelected:!0,rating:0,desc:"Wandering for direction in life, uncertain about one's future path."},fiveProsperity:{$dict_noun:['career','fortune','relationships','politics','motivation'],ref:'monthBranchAux',name:'fiveProsperity',chinese:'\u4e94\u5bcc',icon:'cash-usd',isDefaultSelected:!0,rating:1,desc:'Symbolizes wealth, fortune, and probability of a good political career.'},thrivingDay:{$dict_noun:['persistence','willpower','break','obstacles','energy'],ref:'monthBranchAux',name:'thrivingDay',chinese:'\u4e34\u65e5',icon:'hexagram-o